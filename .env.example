# Dominio final do site (usado em canonical, og:url e sitemap)
PUBLIC_SITE_URL="https://homeostasevita.pt"

# --- Formulario de marcacao (Formspree) ---
# OBRIGATORIO antes de publicar. Sem isto o site nao mostra botao de enviar:
# encaminha as pessoas para WhatsApp/telefone e o build imprime um aviso.
# (Preferivel a fingir que aceita o pedido e deitar o contacto fora.)
# Endpoint em formspree.io: Settings -> Integration -> Endpoint.
# Tem prioridade sobre o valor em src/config/site.ts.
PUBLIC_FORM_ENDPOINT=""
PUBLIC_FORM_PROVIDER="formspree"

# --- Analitica: so dispara apos opt-in no banner RGPD ---
PUBLIC_GA4_ID=""
PUBLIC_META_PIXEL_ID=""
