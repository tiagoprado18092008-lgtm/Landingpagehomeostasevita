---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Credentials from '../components/Credentials.astro';
import Abordagem from '../components/Abordagem.astro';
import Sobre from '../components/Sobre.astro';
import Concerns from '../components/Concerns.astro';
import Services from '../components/Services.astro';
import Acupuntura from '../components/Acupuntura.astro';
import Process from '../components/Process.astro';
import Practitioner from '../components/Practitioner.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Espaco from '../components/Espaco.astro';
import Local from '../components/Local.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
---

<BaseLayout
  title="Medicina Tradicional Chinesa na Maia | Acupuntura — Homeostase Vita"
  description="Clínica de Medicina Tradicional Chinesa na Maia: acupuntura, auriculoterapia, ventosaterapia e reflexologia. Saúde integrativa com avaliação individual e acompanhamento personalizado."
  schema
>
  <Header />

  <main id="conteudo">
    <Hero />
    <Credentials />
    <Services />
    <Abordagem />
    <Sobre />
    <Concerns />
    <Acupuntura />
    <Process />
    <Practitioner />
    <Faq />
    <CtaBand />
    <Espaco />
    <Local />
    <Contact />
  </main>

  <Footer />
  <ChatWidget />
</BaseLayout>
