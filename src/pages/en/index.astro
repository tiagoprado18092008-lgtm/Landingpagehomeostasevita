---
/**
 * Versão inglesa da página inicial.
 *
 * O conteúdo não é duplicado: monta os mesmos componentes da versão
 * portuguesa, que descobrem a língua pelo caminho do pedido (`/en/…`) e se
 * traduzem sozinhos. Uma secção nova na página portuguesa só precisa da
 * mesma linha aqui.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Queixas from '../../components/Queixas.astro';
import Services from '../../components/Services.astro';
import Process from '../../components/Process.astro';
import Practitioner from '../../components/Practitioner.astro';
import Faq from '../../components/Faq.astro';
import Espaco from '../../components/Espaco.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import ChatWidget from '../../components/ChatWidget.astro';
import MobileBar from '../../components/MobileBar.astro';
import { localeFromPath, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<BaseLayout title={t('meta.homeTitle')} description={t('meta.homeDescription')} schema>
  <Header />

  <main id="conteudo">
    <!-- Ordem pensada para quem chega por um anúncio: o quê e com quem,
         serve para mim?, o que se faz, quem trata, como é a 1.ª consulta,
         onde fica, as dúvidas que restam, e o pedido. -->
    <Hero />
    <Queixas />
    <Services />
    <Practitioner />
    <Process />
    <Espaco />
    <Faq />
    <Contact />
  </main>

  <Footer />
  <ChatWidget />
  <MobileBar />
</BaseLayout>
