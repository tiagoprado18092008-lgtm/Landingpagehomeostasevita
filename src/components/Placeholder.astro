---
/**
 * Slot de imagem por preencher.
 *
 * Desenhado para parecer uma decisão, não uma falha: lavagem de aguarela nas
 * cores da marca, marca de água do emblema e uma legenda que diz exatamente
 * que fotografia é precisa ali. Nunca stock genérico de "spa".
 */
interface Props {
  /** Que fotografia é precisa. Aparece na legenda. */
  label: string;
  ratio?: string;
  class?: string;
  /** Varia a mancha entre placeholders vizinhos. */
  seed?: number;
  /** Numeração visível, para casos como a lista de tratamentos. */
  index?: string;
}
const { label, ratio = '4 / 3', class: className, seed = 0, index } = Astro.props;
const uid = `ph${seed}${Math.random().toString(36).slice(2, 6)}`;
const rotate = [12, 48, 76, 122, 158, 200][seed % 6];
const cx = [42, 58, 34, 66, 50, 38][seed % 6];
const cy = [38, 56, 62, 34, 48, 68][seed % 6];
---

<figure class:list={['ph', className]} style={`--ratio:${ratio}`}>
  <svg
    class="ph__wash"
    viewBox="0 0 400 300"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <radialGradient
        id={uid}
        cx={`${cx}%`}
        cy={`${cy}%`}
        r="82%"
        gradientTransform={`rotate(${rotate} .5 .5)`}
      >
        <stop offset="0%" stop-color="var(--color-mist)" stop-opacity="0.98" />
        <stop offset="52%" stop-color="var(--color-mist)" stop-opacity="0.5" />
        <stop offset="100%" stop-color="var(--color-ivory)" stop-opacity="0.96" />
      </radialGradient>
    </defs>
    <rect width="400" height="300" fill={`url(#${uid})`} />
    <g fill="none" stroke="var(--color-navy)" opacity="0.13" stroke-linecap="round">
      <path d="M-20 206c58-10 96-42 144-68 38-20 70-15 104 6 36 22 70 17 104-6 28-19 54-25 88-19" stroke-width="2.5" />
      <path d="M-20 244c50-6 88-28 132-46 36-16 66-12 98 5 34 18 64 14 96-5 26-15 50-19 84-15" stroke-width="1.6" />
    </g>
  </svg>

  <figcaption class="ph__caption">
    {index && <span class="ph__index">{index}</span>}
    <span class="ph__label">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="4.5" width="18" height="15" rx="2.5" />
        <circle cx="8.6" cy="10" r="1.6" />
        <path d="m4 17 5-4.6 4.4 4 3-2.6L20 18" />
      </svg>
      {label}
    </span>
  </figcaption>
</figure>

<style>
  .ph {
    position: relative;
    display: block;
    margin: 0;
    aspect-ratio: var(--ratio);
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--color-ivory);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  .ph__wash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ph__caption {
    position: absolute;
    left: var(--spacing-s4);
    bottom: var(--spacing-s4);
    right: var(--spacing-s4);
    display: flex;
    align-items: center;
    gap: var(--spacing-s2);
  }

  .ph__index {
    display: grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background-color: var(--color-navy);
    color: var(--color-ivory);
    font-size: 0.6875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .ph__label {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-width: 0;
    padding: 5px var(--spacing-s3);
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-paper) 92%, transparent);
    box-shadow: 0 0 0 1px var(--hairline);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-teal-deep);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ph__label svg {
    flex: none;
  }
</style>
