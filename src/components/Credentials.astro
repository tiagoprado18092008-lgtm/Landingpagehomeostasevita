---
import { site } from '../config/site';
import Icon from './Icon.astro';

/**
 * Faixa fina de legitimidade, logo a seguir ao hero. A cédula não é
 * decoração: é exigida pelo RJPPS para publicidade em saúde.
 */
const itens = [
  {
    icon: 'check',
    label: 'Cédula Profissional ACSS',
    valor: `n.º ${site.credentials.acss}`,
  },
  { icon: 'person', label: 'Avaliação individual', valor: 'Antes de qualquer tratamento' },
  { icon: 'leaf', label: 'Várias técnicas', valor: 'Escolhidas caso a caso' },
];
---

<section class="credenciais" aria-label="Credenciais da clínica">
  <ul class="container credenciais__lista">
    {
      itens.map((item, i) => (
        <li class="credenciais__item reveal">
          <span class={`credenciais__icone credenciais__icone--${['navy', 'teal', 'green', 'teal'][i % 4]}`} aria-hidden="true">
            <Icon name={item.icon} size={16} />
          </span>
          <span class="credenciais__texto">
            <span class="credenciais__label">{item.label}</span>
            <span class="credenciais__valor">
              {item.valor}
            </span>
          </span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .credenciais {
    background-color: #fff;
    border-block: 1px solid var(--hairline-cool);
  }

  .credenciais__lista {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-s4) var(--spacing-s6);
    list-style: none;
    padding-block: var(--spacing-s5);
  }

  .credenciais__item {
    display: flex;
    align-items: center;
    gap: var(--spacing-s3);
  }

  .credenciais__icone {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
  }

  /* As três cores da marca, uma por item — uma faixa de
     confiança não precisa de ser cinzenta para ser séria. */
  .credenciais__icone--navy {
    background-color: color-mix(in srgb, var(--color-navy) 16%, var(--color-paper));
    color: var(--color-navy);
  }
  .credenciais__icone--teal {
    background-color: color-mix(in srgb, var(--color-teal) 24%, var(--color-paper));
    color: var(--color-teal-deep);
  }
  .credenciais__icone--green {
    background-color: color-mix(in srgb, var(--color-green) 24%, var(--color-paper));
    color: var(--color-green-deep);
  }

  .credenciais__texto {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
    min-width: 0;
  }

  .credenciais__label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .credenciais__valor {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-navy);
  }

  @media (min-width: 640px) {
    .credenciais__lista {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .credenciais__lista {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
