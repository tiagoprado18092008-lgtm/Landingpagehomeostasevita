---
import { site } from '../config/site';
import Icon from './Icon.astro';
import { localeFromPath, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

/**
 * O que acontece quando chego. À esquerda, fixos enquanto se lê, o título e
 * o lead. À direita, os três passos e, a fechar, a objeção que mais trava a
 * marcação ("dói?"), respondida com o texto da própria clínica e com os
 * botões ao lado.
 */
const passos = [
  { nome: t('lp.c.s1'), texto: t('lp.c.s1Text'), cor: 'verde' },
  { nome: t('lp.c.s2'), texto: t('process.step3Text'), cor: 'teal' },
  { nome: t('lp.c.s3'), texto: t('process.step4Text'), cor: 'navy' },
];
---

<section class="section passos" id="percurso" aria-labelledby="percurso-titulo">
  <div class="container passos__grelha">
    <div class="passos__cabeca">
      <h2 class="passos__titulo reveal" id="percurso-titulo">{t('lp.c.title')}</h2>
      <p class="passos__lead reveal">{t('process.lead')}</p>
    </div>

    <div class="passos__corpo">
      <ol class="passos__lista" data-stagger="90">
        {
          passos.map((p) => (
            <li class={`passo passo--${p.cor} reveal`}>
              <span class="passo__ponto" aria-hidden="true" />
              <div>
                <h3 class="passo__nome">{p.nome}</h3>
                <p class="passo__texto">{p.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="passos__dor reveal">
        <h3 class="passos__pergunta">{t('lp.c.hurtQ')}</h3>
        <p class="passos__resposta">{t('lp.c.hurtA')}</p>
        <p class="passos__marcacao">
          <strong>{t('process.bookingStrong')}.</strong>
          {t('process.bookingText')}.
        </p>
        <div class="passos__acoes">
          <a href="#marcacao" class="btn passos__marcar">{t('common.book')}</a>
          <a href={site.phone.whatsapp} class="btn btn-whatsapp" rel="noopener">
            <Icon name="whatsapp" size={18} />
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .passos {
    background-color: var(--color-paper);
  }

  .passos__grelha {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .passos__titulo {
    font-size: var(--t-h2);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-navy-deep);
  }

  .passos__lead {
    max-width: 44ch;
    margin-top: var(--spacing-s5);
    font-size: var(--t-lead);
    line-height: 1.4;
    color: var(--color-navy-ink);
  }

  /* --- Os passos -------------------------------------------------------- */
  .passos__lista {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A ordem lê-se de cima para baixo; o ponto de cor é o do emblema. */
  .passo {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--spacing-s5);
    align-items: start;
  }
  .passo__ponto {
    width: 18px;
    height: 18px;
    margin-top: 0.45em;
    border-radius: 50%;
    background-color: var(--ponto);
  }
  .passo--verde {
    --ponto: var(--color-green-deep);
  }
  .passo--teal {
    --ponto: var(--color-teal);
  }
  .passo--navy {
    --ponto: var(--color-navy);
  }

  .passo__nome {
    font-family: var(--font-sans);
    font-size: var(--t-lead);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.25;
    color: var(--color-navy-deep);
  }
  .passo__texto {
    max-width: 52ch;
    margin-top: var(--spacing-s2);
    font-size: var(--t-body);
    color: var(--color-navy-ink);
  }

  /* --- "Dói?": painel navy que fecha a secção com os botões. ------------ */
  .passos__dor {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    background-color: var(--color-navy-deep);
    color: var(--color-ivory);
  }
  .passos__pergunta {
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }
  .passos__resposta {
    max-width: 44ch;
    margin-top: var(--spacing-s4);
    font-size: var(--t-lead);
    line-height: 1.4;
  }
  .passos__marcacao {
    margin-top: var(--spacing-s4);
    font-size: var(--t-body);
  }
  .passos__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-s3);
    margin-top: var(--spacing-s5);
  }
  .passos__marcar {
    background-color: var(--color-ivory);
    color: var(--color-navy-deep);
  }
  .passos__marcar:hover {
    background-color: #fff;
  }

  @media (max-width: 599px) {
    .passos__acoes .btn {
      flex: 1 1 100%;
    }
  }

  /* Ecrã largo: título e lead numa coluna à esquerda, fixos enquanto o
     texto passa; passos e painel na coluna da direita. */
  @media (min-width: 900px) {
    .passos__grelha {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(3rem, 6vw, 6rem);
    }
    .passos__cabeca {
      align-self: start;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>
