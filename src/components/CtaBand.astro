---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import Icon from './Icon.astro';
import azulejo from '../assets/img/azulejo.png';

/**
 * Faixa de chamada a meio da página. Quem já leu até aqui não devia ter de
 * descer até ao fim para marcar.
 *
 * Único sítio da página onde a mandala botânica do emblema aparece por
 * extenso, a espreitar dos cantos — um momento de pausa antes do resto do
 * percurso, por isso o traço é mais rico aqui e discreto em todo o lado.
 *
 * Uma imagem só, de margem a margem: a arte já vem com os quatro cantos e o
 * centro liso na própria imagem, por isso object-fit:cover chega — nada de
 * recortar em quatro pedaços, que era o que deixava um rectângulo a marcar-se
 * a meio da faixa. O fundo liso da arte (--color-mosaico) é o mesmo da FAQ
 * acima, e as arestas de cima e de baixo desvanecem por máscara para não
 * haver linha de corte com as secções vizinhas.
 */
---

<section class="faixa" aria-label="Marcar consulta">
  <Image
    class="faixa__img"
    src={azulejo}
    alt=""
    widths={[768, 1120, 1440, 1672]}
    sizes="100vw"
    quality={92}
    format="webp"
    loading="lazy"
    decoding="async"
  />

  <div class="container faixa__inner">
    <p class="faixa__eyebrow reveal">Dê o primeiro passo</p>
    <p class="faixa__titulo reveal" style="--reveal-delay:40ms">
      A sua consulta começa com uma conversa.
    </p>
    <p class="faixa__sub reveal" style="--reveal-delay:100ms">
      Sem compromisso: pode ligar só para esclarecer dúvidas antes de decidir.
    </p>

    <div class="faixa__accoes reveal" style="--reveal-delay:160ms">
      <a href="#marcacao" class="btn btn-primary faixa__btn">Marcar consulta</a>
      <a href={site.phone.whatsapp} class="btn btn-whatsapp faixa__btn" rel="noopener">
        <Icon name="whatsapp" size={18} />
        WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .faixa {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 10vw, 8.5rem);
    /* Mesma superficie da FAQ acima (nao ha costura a ver) e, em baixo, uma
       rampa longa ate a lavagem azul do Local: a seccao seguinte comeca a
       aparecer antes de a linha de corte chegar. */
    background-color: var(--color-mosaico);
    background-image: linear-gradient(
      to bottom,
      var(--color-mosaico) 0,
      var(--color-mosaico) 64%,
      var(--color-azul-lavado) 100%
    );
  }

  .faixa :global(.faixa__img) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* A arte vinha cortada a direito nos dois topos, com folhas fatiadas a
       meio. A mascara desvanece-a: as folhas surgem e dissolvem-se no fundo
       liso, e em baixo deixam passar a rampa para o azul. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 11%,
      #000 64%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 11%,
      #000 64%,
      transparent 100%
    );
  }

  .faixa__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
  }

  .faixa__eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-teal-deep);
  }

  .faixa__titulo {
    margin-top: var(--spacing-s4);
    max-width: 20ch;
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: var(--tracking-h2);
    color: var(--color-navy);
    text-wrap: balance;
  }

  .faixa__sub {
    margin-top: var(--spacing-s4);
    max-width: 42ch;
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-muted);
  }

  .faixa__accoes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-s3);
    margin-top: var(--spacing-s7);
  }

  @media (max-width: 560px) {
    .faixa__btn {
      flex: 1 1 100%;
    }
  }
</style>
