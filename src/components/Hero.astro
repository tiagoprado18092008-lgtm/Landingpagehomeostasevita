---
import { getImage } from 'astro:assets';
import { site } from '../config/site';
import Icon from './Icon.astro';
import Emblem from './Emblem.astro';
import fotoLarga from '../assets/img/hero-acupuntura.png';
import fotoAlta from '../assets/img/hero-acupuntura-vertical.png';
import teresa from '../assets/img/teresa.jpg';
import { localeFromPath, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

/**
 * Primeiro ecrã de uma página que recebe anúncios: a fotografia de ecrã
 * inteiro de sempre, e por cima dela o que quem clicou quer saber — é
 * acupuntura, é na Maia, é com quem — e as três vias de contacto.
 *
 * Diferenças para a versão anterior (out. 2026):
 * - o título responde à pesquisa ("Acupuntura na Maia"), não ao nome;
 * - o texto encosta à esquerda, onde o véu escurece, e as agulhas ficam
 *   à vista do lado direito em vez de por baixo das letras;
 * - telefone e WhatsApp juntam-se ao botão de marcação, e a cédula da
 *   Teresa aparece logo ali, com a cara dela;
 * - sem zoom na fotografia: serve-se o original a toda a largura.
 *
 * Arte dirigida: no telemóvel entra o recorte vertical feito de propósito,
 * porque a horizontal cortada a 390px só mostrava desfoque. Os dois saem
 * da versão melhorada da fotografia (1672×941); o vertical é um recorte
 * dela à resolução nativa (583×941), sem ampliação.
 */
const larga = await getImage({
  src: fotoLarga,
  widths: [1080, 1440, 1920, 2600],
  format: 'webp',
  quality: 82,
});
const alta = await getImage({
  src: fotoAlta,
  widths: [480, 720, 900, 1200, 1500, 1800],
  format: 'webp',
  quality: 82,
});
const retrato = await getImage({ src: teresa, width: 144, format: 'webp', quality: 80 });
---

<section class="hero" id="topo" aria-labelledby="hero-titulo">
  <div class="hero__foto">
    <picture>
      <source
        media="(min-width: 768px) and (min-aspect-ratio: 4 / 5)"
        srcset={larga.srcSet.attribute}
        sizes="100vw"
        width={larga.attributes.width}
        height={larga.attributes.height}
      />
      <img
        class="hero__img"
        src={alta.src}
        srcset={alta.srcSet.attribute}
        sizes="100vw"
        width={alta.attributes.width}
        height={alta.attributes.height}
        alt={t('hero.imgAlt')}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero__veu" aria-hidden="true"></div>
  </div>

  <div class="hero__texto">
    <h1 id="hero-titulo">
      <span class="hero__marca">
        <Emblem size={52} loading="eager" class="hero__emblema" />
        <span class="hero__nome">{site.name}</span>
      </span>
      <span class="sr-only"> — </span>
      <span class="hero__titulo">{t('lp.hero.title')}</span>
    </h1>
    <p class="hero__sub">{t('lp.hero.sub')}</p>

    <div class="hero__acoes">
      <a href="#marcacao" class="btn hero__marcar">{t('common.book')}</a>
      <a href={`tel:${site.phone.tel}`} class="btn hero__tel">
        <Icon name="phone" size={18} />
        {site.phone.display}
      </a>
      <a href={site.phone.whatsapp} class="btn btn-whatsapp" rel="noopener">
        <Icon name="whatsapp" size={18} />
        WhatsApp
      </a>
    </div>

    <a class="hero__quem" href="#terapeuta">
      <img
        src={retrato.src}
        width="72"
        height="72"
        alt=""
        class="hero__retrato"
        loading="eager"
        decoding="async"
      />
      <span>
        <strong>{site.practitioner.firstName} {site.practitioner.lastName}</strong>
        <span class="hero__quem-linha">
          {t('lp.hero.whoLine')}&nbsp;{site.credentials.acss} · {t('lp.hero.whereLine')}
        </span>
      </span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: max(600px, 100svh);
    padding-top: var(--header-h);
    overflow: clip;
    /* Média da fotografia, escurecida: se a imagem tardar, não há flash. */
    background-color: #2e2019;
    color: var(--color-ivory);
  }

  /* --- Fotografia ------------------------------------------------------ */
  .hero__foto {
    position: absolute;
    inset: var(--header-h) 0 0;
    z-index: -1;
  }
  .hero__foto picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 72%;
    animation: hero-entrar 1400ms var(--ease) both;
  }

  /* Véu neutro só onde há texto. No telemóvel o texto vai em cima — os
     botões têm de caber no primeiro ecrã, acima do banner de cookies — e
     o véu aclara para baixo, onde as agulhas ficam à vista. */
  .hero__veu {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.72) 55%,
      rgba(0, 0, 0, 0.25) 85%,
      rgba(0, 0, 0, 0.1) 100%
    );
  }

  /* --- Texto ----------------------------------------------------------- */
  .hero {
    align-items: start;
  }
  .hero__texto {
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding: clamp(1.75rem, 5vh, 3rem) var(--gutter) clamp(2rem, 6vh, 3.5rem);
  }

  /* O nome da clínica, como no logótipo: emblema e capitulares espaçadas. */
  .hero__marca {
    display: flex;
    align-items: center;
    gap: var(--spacing-s3);
    margin-bottom: clamp(1rem, 2.5vw, 1.75rem);
  }
  .hero__marca :global(.hero__emblema) {
    width: clamp(40px, 4vw, 52px);
    height: auto;
  }
  .hero__nome {
    font-family: var(--font-wordmark);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-ivory);
  }

  .hero__titulo {
    display: block;
    max-width: 8ch;
    font-size: clamp(2.75rem, 12vw, 4.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: var(--color-ivory);
  }

  .hero__sub {
    max-width: 38ch;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-size: var(--t-lead);
    line-height: 1.45;
    color: var(--color-ivory);
  }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-s3);
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* Sobre a fotografia o botão principal é claro: é a coisa mais luminosa
     do ecrã, e é para lá que o olho vai. */
  .hero__marcar {
    background-color: var(--color-ivory);
    color: var(--color-navy-deep);
  }
  .hero__marcar:hover {
    background-color: #fff;
  }
  .hero__tel {
    background-color: rgba(247, 247, 244, 0.16);
    color: var(--color-ivory);
  }
  .hero__tel:hover {
    background-color: rgba(247, 247, 244, 0.26);
  }

  .hero__quem {
    display: flex;
    align-items: center;
    gap: var(--spacing-s4);
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    font-size: var(--t-small);
    line-height: 1.45;
    color: var(--color-ivory);
    text-decoration: none;
  }
  .hero__quem strong {
    display: block;
    font-size: var(--t-body);
  }
  .hero__quem:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hero__retrato {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 25%;
    background-color: var(--color-step);
    transition: scale var(--dur) var(--ease);
  }
  .hero__quem:hover .hero__retrato {
    scale: 1.06;
  }

  :global(.hero :focus-visible) {
    outline-color: var(--color-ivory);
    outline-offset: 3px;
  }

  /* --- Movimento: a fotografia aparece, o texto sobe em cascata. -------- */
  .hero__texto > * {
    animation: hero-subir 800ms var(--ease) both;
  }
  .hero__sub {
    animation-delay: 90ms;
  }
  .hero__acoes {
    animation-delay: 170ms;
  }
  .hero__quem {
    animation-delay: 250ms;
  }
  @keyframes hero-entrar {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes hero-subir {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .hero__sub {
      font-size: var(--t-body);
    }
    .hero__acoes .btn {
      flex: 1 1 calc(50% - 6px);
      padding-inline: var(--spacing-s4);
    }
    .hero__acoes .hero__marcar {
      flex-basis: 100%;
    }
  }

  /* --- Ecrã largo: fotografia horizontal; o texto à esquerda, sobre um
     véu que escurece desse lado, e as agulhas limpas à direita. -------- */
  @media (min-width: 768px) and (min-aspect-ratio: 4 / 5) {
    .hero {
      align-items: center;
    }
    .hero__img {
      object-position: 62% 40%;
    }
    .hero__veu {
      background: linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.82) 0%,
        rgba(0, 0, 0, 0.66) 34%,
        rgba(0, 0, 0, 0.18) 62%,
        rgba(0, 0, 0, 0) 80%
      );
    }
    .hero__texto {
      padding-block: clamp(2.5rem, 7vh, 5rem);
    }
    .hero__texto > * {
      max-width: min(36rem, 46vw);
    }
    .hero__titulo {
      max-width: 8ch;
      font-size: clamp(3.5rem, 7vw, 6.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__img,
    .hero__texto > * {
      animation: none;
    }
  }
</style>
