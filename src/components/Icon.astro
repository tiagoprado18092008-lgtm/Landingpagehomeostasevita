---
/**
 * Ícones lineares desenhados para reproduzir os medalhões do flyer:
 * traço fino, cantos arredondados, sem preenchimento (salvo o yin-yang).
 * Todos partilham a grelha 24×24 para alinharem entre si.
 */
interface Props {
  name: string;
  /**
   * Lado do ícone em px. Definido aqui e não por CSS do componente que o usa:
   * o CSS com scope do pai não alcança a raiz de um componente filho.
   */
  size?: number;
  class?: string;
  /** Decorativo por omissão. Passar um título torna-o acessível. */
  title?: string;
}

const { name, size = 24, class: className, title } = Astro.props;

