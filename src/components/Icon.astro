const d = paths[name];
if (!d) throw new Error(`Icon: nome desconhecido "${name}"`);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  focusable="false"
>
  {title && <title>{title}</title>}
  <Fragment set:html={d} />
</svg>
