---
import { site } from '../config/site';
import Icon from './Icon.astro';
import MapCard from './MapCard.astro';

/**
 * Onde é e como se chega lá. Era uma linha perdida no rodapé; passa a
 * secção própria, com o mapa em tamanho útil.
 */
const detalhes = [
  {
    icon: 'pin',
    label: 'Morada',
    valor: `${site.address.street}, ${site.address.postalCode} ${site.address.locality}`,
  },
  /* Sem horário afixado — o que a pessoa precisa de saber aqui é que não
     se aparece sem avisar. */
  {
    icon: 'clock',
    label: 'Consultas',
    valor: 'Mediante marcação prévia',
  },
];
---

<section class="section surface-azul local" id="local" aria-labelledby="local-titulo">
  <div class="container local__inner">
    <div class="local__texto">
      <p class="eyebrow reveal">Onde estamos</p>
      <h2 class="h2 reveal" id="local-titulo">Como chegar até nós</h2>
      <p class="lead reveal" style="--reveal-delay:80ms">
        A Homeostase Vita funciona na Rua Engenheiro Frederico Ulrich, na Maia — no
        espaço que se vê acima.
      </p>

      <ul class="local__detalhes reveal" style="--reveal-delay:140ms">
        {
          detalhes.map((d) => (
            <li>
              <span class="local__icone" aria-hidden="true">
                <Icon name={d.icon} size={17} />
              </span>
              <span class="local__par">
                <span class="local__label">{d.label}</span>
                <span class="local__valor">{d.valor}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="local__mapa reveal reveal--scale" style="--reveal-delay:180ms" id="mapa">
      <MapCard />
    </div>
  </div>
</section>

<style>
  /* A lavagem azul acabava a direito contra o bege do Contacto, logo a seguir
     a faixa do mosaico — que agora nao tem costura nenhuma. Mesma solucao:
     uma rampa longa no fim da seccao em vez de uma linha. */
  .local {
    background-image: linear-gradient(
      to bottom,
      var(--color-azul-lavado) 0,
      var(--color-azul-lavado) calc(100% - clamp(6rem, 14vw, 11rem)),
      var(--color-ivory) 100%
    );
  }

  .local__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .local__texto {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s4);
  }

  .local__texto .eyebrow {
    margin-bottom: 0;
  }

  .local__detalhes {
    list-style: none;
    margin: var(--spacing-s3) 0 0;
    padding: 0;
    border-top: 1px solid var(--hairline-cool);
  }

  .local__detalhes li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-s4);
    padding-block: var(--spacing-s4);
    border-bottom: 1px solid var(--hairline-cool);
  }

  .local__icone {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: var(--color-ivory);
    color: var(--color-teal-deep);
  }

  .local__par {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .local__label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .local__valor {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-navy);
  }

  @media (min-width: 900px) {
    .local__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
</style>
