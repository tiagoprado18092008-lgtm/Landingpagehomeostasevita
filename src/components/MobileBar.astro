---
import { site } from '../config/site';
import Icon from './Icon.astro';
import { localeFromPath, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

/**
 * No telemóvel — onde chega a maior parte do tráfego dos anúncios — as três
 * vias de contacto ficam sempre a um toque, no fundo do ecrã. Sai de cena
 * quando o formulário de marcação está à vista, para não o duplicar.
 *
 * Os cliques são medidos pelo Tracking como os outros links (tel:/wa.me),
 * com a zona "barra-movel".
 */
---

<nav class="barra" id="barra-movel" aria-label={t('lp.bar.aria')} data-barra>
  <a href={`tel:${site.phone.tel}`} class="barra__btn barra__btn--tel">
    <Icon name="phone" size={20} />
    {t('lp.bar.call')}
  </a>
  <a href={site.phone.whatsapp} class="barra__btn barra__btn--wa" rel="noopener">
    <Icon name="whatsapp" size={20} />
    WhatsApp
  </a>
  <a href="#marcacao" class="barra__btn barra__btn--marcar">{t('lp.bar.book')}</a>
</nav>

<style>
  .barra {
    display: none;
  }

  @media (max-width: 767px) {
    .barra {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 85;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 6px;
      padding: 8px 8px calc(8px + env(safe-area-inset-bottom));
      background-color: var(--color-step);
      transition: translate var(--dur-slow) var(--ease);
    }
    .barra[data-escondida='true'] {
      translate: 0 110%;
    }

    /* O fim da página não pode ficar por baixo da barra. */
    :global(body) {
      padding-bottom: calc(72px + env(safe-area-inset-bottom));
    }
  }

  .barra__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 52px;
    border-radius: var(--radius-pill);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: scale var(--dur-fast) var(--ease);
  }
  .barra__btn:active {
    scale: 0.96;
  }

  .barra__btn--tel {
    background-color: var(--color-step-2);
    color: var(--color-navy-deep);
  }
  .barra__btn--wa {
    background-color: #0b6e5f;
    color: #fff;
  }
  .barra__btn--marcar {
    background-color: var(--color-navy);
    color: var(--color-ivory);
  }
</style>

<script>
  const barra = document.querySelector<HTMLElement>('[data-barra]');
  const alvo = document.getElementById('marcacao');

  if (barra && alvo && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([e]) => {
        barra.dataset.escondida = String(e.isIntersecting);
      },
      { threshold: 0.15 },
    ).observe(alvo);
  }
</script>
