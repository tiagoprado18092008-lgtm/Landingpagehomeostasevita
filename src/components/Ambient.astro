---
/**
 * Manchas de luz ao fundo de uma secção — dois ou três halos muito suaves
 * nas cores da marca, desfocados e fora de centro.
 *
 * É o que dá profundidade a um fundo quase branco sem lhe pôr nada em cima.
 * Vive sempre atrás do conteúdo e nunca apanha o rato.
 *
 * A secção que a usa precisa de `position: relative` e `overflow: hidden`.
 */
interface Props {
  /** Composição das manchas. */
  variant?: 'calmo' | 'duplo' | 'canto';
  /** Intensidade global. Manter baixo: isto é atmosfera, não decoração. */
  opacity?: number;
  class?: string;
}
const { variant = 'calmo', opacity = 1, class: className } = Astro.props;
---

<div
  class:list={['amb', `amb--${variant}`, className]}
  style={`--amb-o:${opacity}`}
  aria-hidden="true"
>
  <span class="amb__halo amb__halo--frio"></span>
  <span class="amb__halo amb__halo--quente"></span>
  <span class="amb__halo amb__halo--verde"></span>
</div>

<style>
  .amb {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: var(--amb-o, 1);
  }

  .amb__halo {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
  }

  .amb__halo--frio {
    background: radial-gradient(circle, var(--color-mist) 0%, transparent 68%);
  }

  .amb__halo--quente {
    background: radial-gradient(circle, var(--color-ivory) 0%, transparent 68%);
  }

  /* Verde e azul do emblema — a mancha que traz a cor da marca gráfica
     (o yin-yang em verde/azul) para o fundo das secções. É a única mancha
     saturada das três, por isso carrega o essencial da cor da página —
     sem ela o fundo lê-se todo bege e a marca desaparece. */
  .amb__halo--verde {
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-teal) 38%, transparent) 0%,
      color-mix(in srgb, var(--color-green) 30%, transparent) 48%,
      transparent 74%
    );
  }

  /* --- Composições --- */
  .amb--calmo .amb__halo--frio {
    width: 46vw;
    height: 46vw;
    max-width: 620px;
    max-height: 620px;
    top: -14%;
    right: -8%;
    opacity: 0.75;
  }
  .amb--calmo .amb__halo--quente {
    width: 38vw;
    height: 38vw;
    max-width: 520px;
    max-height: 520px;
    bottom: -18%;
    left: -6%;
    opacity: 0.85;
  }
  .amb--calmo .amb__halo--verde {
    width: 26vw;
    height: 26vw;
    max-width: 360px;
    max-height: 360px;
    top: 34%;
    left: 40%;
    opacity: 0.42;
  }

  .amb--duplo .amb__halo--frio {
    width: 42vw;
    height: 42vw;
    max-width: 560px;
    max-height: 560px;
    top: -10%;
    left: 8%;
    opacity: 0.7;
  }
  .amb--duplo .amb__halo--quente {
    width: 34vw;
    height: 34vw;
    max-width: 460px;
    max-height: 460px;
    bottom: -12%;
    right: 4%;
    opacity: 0.8;
  }
  .amb--duplo .amb__halo--verde {
    width: 30vw;
    height: 30vw;
    max-width: 400px;
    max-height: 400px;
    top: 26%;
    right: 20%;
    opacity: 0.48;
  }

  .amb--canto .amb__halo--frio {
    width: 52vw;
    height: 52vw;
    max-width: 700px;
    max-height: 700px;
    bottom: -26%;
    right: -12%;
    opacity: 0.8;
  }
  .amb--canto .amb__halo--quente {
    width: 30vw;
    height: 30vw;
    max-width: 400px;
    max-height: 400px;
    top: -10%;
    left: -8%;
    opacity: 0.7;
  }
  .amb--canto .amb__halo--verde {
    width: 28vw;
    height: 28vw;
    max-width: 380px;
    max-height: 380px;
    top: 6%;
    right: 4%;
    opacity: 0.42;
  }

  /* O desfoque a 90px é caro em ecrãs pequenos e quase não se vê. */
  @media (max-width: 700px) {
    .amb__halo {
      filter: blur(60px);
    }
  }
</style>
