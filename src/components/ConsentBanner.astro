---
/**
 * Consentimento RGPD.
 *
 * Nada de terceiros carrega antes do opt-in: GA4, Meta Pixel e o mapa do
 * Google ficam bloqueados até "Aceitar". A escolha fica guardada e pode ser
 * revista pelo link no rodapé.
 */
import { localeFromPath, localizePath, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<div class="consent-banner" data-consent hidden role="dialog" aria-labelledby="consent-titulo" aria-describedby="consent-texto">
  <div class="consent-banner__inner">
    <div>
      <h2 class="consent-banner__title" id="consent-titulo">{t('consent.title')}</h2>
      <p class="consent-banner__text" id="consent-texto">
        {t('consent.text')}{' '}
        <a href={localizePath('/politica-de-cookies', locale)} class="link-gold">
          {t('consent.policy')}
        </a>
      </p>
    </div>
    <div class="consent-banner__actions">
      <button type="button" class="btn btn-secondary" data-consent-reject>{t('consent.reject')}</button>
      <button type="button" class="btn btn-primary" data-consent-accept>{t('consent.accept')}</button>
    </div>
  </div>
</div>

<style>
  .consent-banner {
    position: fixed;
    left: clamp(12px, 3vw, 24px);
    right: clamp(12px, 3vw, 24px);
    bottom: clamp(12px, 3vw, 24px);
    z-index: 100;
    padding: var(--spacing-s5);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background-color: var(--color-paper);
    box-shadow: var(--shadow-3);
    max-width: 760px;
    margin-inline: auto;
  }

  .consent-banner[hidden] {
    display: none;
  }

  .consent-banner__inner {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s4);
  }

  .consent-banner__title {
    font-size: 1.125rem;
    margin-bottom: var(--spacing-s2);
  }

  .consent-banner__text {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .consent-banner__actions {
    display: flex;
    gap: var(--spacing-s3);
  }

  .consent-banner__actions .btn {
    flex: 1;
    min-height: 44px;
    font-size: 0.9375rem;
  }

  @media (min-width: 720px) {
    .consent-banner__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--spacing-s6);
    }
    .consent-banner__actions {
      flex: none;
    }
    .consent-banner__actions .btn {
      flex: none;
    }
  }
</style>

<script>
  const KEY = 'hv-consent';
  const banner = document.querySelector<HTMLElement>('[data-consent]');

  /**
   * Carrega Google Ads, GA4, Clarity e Meta Pixel. Só corre depois de
   * "Aceitar" — antes disso não sai nenhum pedido para terceiros.
   */
  const loadAnalytics = () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const w = window as any;
    if (w.__hvAnalyticsLoaded) return;
    w.__hvAnalyticsLoaded = true;

    const meta = (name: string) =>
      document.querySelector(`meta[name="hv:${name}"]`)?.getAttribute('content') || '';
    const ga = meta('ga4');
    const ads = meta('ads');
    const clarity = meta('clarity');
    const pixel = meta('pixel');

    const tagId = ads || ga;
    if (tagId) {
      w.dataLayer = w.dataLayer || [];
      w.gtag = function gtag() {
        // eslint-disable-next-line prefer-rest-params
        w.dataLayer.push(arguments);
      };
      // Consent Mode v2 (modo básico): as tags só existem depois do opt-in,
      // mas a Google exige o sinal explícito para tráfego do EEE.
      // ad_personalization fica negado: sem remarketing numa página de saúde.
      w.gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
      });
      w.gtag('consent', 'update', {
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'denied',
        analytics_storage: 'granted',
      });
      w.gtag('js', new Date());
      if (ga) w.gtag('config', ga);
      if (ads) w.gtag('config', ads);

      const s = document.createElement('script');
      s.async = true;
      s.src = `https://www.googletagmanager.com/gtag/js?id=${tagId}`;
      document.head.appendChild(s);
    }

    if (clarity && !w.clarity) {
      w.clarity = function clarityQueue() {
        // eslint-disable-next-line prefer-rest-params
        (w.clarity.q = w.clarity.q || []).push(arguments);
      };
      const s = document.createElement('script');
      s.async = true;
      s.src = `https://www.clarity.ms/tag/${clarity}`;
      document.head.appendChild(s);
      w.clarity('consent');
    }

    window.dispatchEvent(new CustomEvent('hv:analytics-ready'));

    if (pixel) {
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://connect.facebook.net/en_US/fbevents.js';
      s.onload = () => {
        // @ts-expect-error — fbq é injetado pelo script da Meta.
        window.fbq?.('init', pixel);
        // @ts-expect-error — idem.
        window.fbq?.('track', 'PageView');
      };
      document.head.appendChild(s);
    }
  };

  if (banner) {
    const stored = localStorage.getItem(KEY);

    if (stored === 'aceite') {
      loadAnalytics();
    } else if (stored !== 'recusado') {
      banner.hidden = false;
    }

    const close = (choice: 'aceite' | 'recusado') => {
      try {
        localStorage.setItem(KEY, choice);
      } catch {
        // Armazenamento bloqueado: a escolha vale só para esta visita.
      }
      banner.hidden = true;
      if (choice === 'aceite') {
        loadAnalytics();
        window.dispatchEvent(new CustomEvent('hv:consent-accepted'));
      }
    };

    banner
      .querySelector('[data-consent-accept]')
      ?.addEventListener('click', () => close('aceite'));
    banner
      .querySelector('[data-consent-reject]')
      ?.addEventListener('click', () => close('recusado'));
  }

  // Link "Definições de cookies" no rodapé reabre a escolha.
  document.querySelector('[data-open-consent]')?.addEventListener('click', () => {
    localStorage.removeItem(KEY);
    if (banner) {
      banner.hidden = false;
      banner.querySelector<HTMLButtonElement>('[data-consent-accept]')?.focus();
    }
  });
</script>
