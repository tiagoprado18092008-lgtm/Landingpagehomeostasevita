---
/**
 * Consentimento RGPD.
 *
 * Nada de terceiros carrega antes do opt-in: GA4, Meta Pixel e o mapa do
 * Google ficam bloqueados até "Aceitar". A escolha fica guardada e pode ser
 * revista pelo link no rodapé.
 */
import { localeFromPath, localizePath, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<div class="consent-banner" data-consent hidden role="dialog" aria-labelledby="consent-titulo" aria-describedby="consent-texto">
  <div class="consent-banner__inner">
    <div>
      <h2 class="consent-banner__title" id="consent-titulo">{t('consent.title')}.</h2>{' '}
      <p class="consent-banner__text" id="consent-texto">
        {t('consent.text')}{' '}
        <a href={localizePath('/politica-de-cookies', locale)} class="link-gold">
          {t('consent.policy')}
        </a>
      </p>
    </div>
    <div class="consent-banner__actions">
      <button type="button" class="btn btn-secondary" data-consent-reject>{t('consent.reject')}</button>
      <button type="button" class="btn btn-primary" data-consent-accept>{t('consent.accept')}</button>
    </div>
  </div>
</div>

<style>
  /* Compacto de propósito (out. 2026): na versão anterior o banner ocupava
     um terço do ecrã do telemóvel e tapava o botão de marcação do hero —
     precisamente o primeiro ecrã de quem chega pelos anúncios. Agora é uma
     faixa baixa, encostada ao fundo, com as duas escolhas do mesmo peso. */
  .consent-banner {
    position: fixed;
    left: 8px;
    right: 8px;
    bottom: 8px;
    z-index: 100;
    max-width: 880px;
    margin-inline: auto;
    padding: 14px 16px;
    border-radius: 20px;
    background-color: var(--color-navy-deep);
    color: var(--color-ivory);
    box-shadow: var(--shadow-3); /* diálogo flutuante: taste-skill-ignore */
  }

  .consent-banner[hidden] {
    display: none;
  }

  /* Por cima da barra de contactos do telemóvel, nunca por baixo dela. */
  @media (max-width: 767px) {
    .consent-banner {
      bottom: calc(76px + env(safe-area-inset-bottom));
    }
  }

  .consent-banner__inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .consent-banner__title {
    display: inline;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-ivory);
  }

  .consent-banner__text {
    display: inline;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .consent-banner__text a {
    color: inherit;
  }

  .consent-banner__actions {
    display: flex;
    gap: 8px;
  }

  .consent-banner__actions .btn {
    flex: 1;
    min-height: 44px;
    padding-inline: var(--spacing-s5);
    font-size: 0.9375rem;
  }
  .consent-banner__actions .btn-secondary {
    background-color: color-mix(in srgb, var(--color-ivory) 16%, transparent);
    color: var(--color-ivory);
  }
  .consent-banner__actions .btn-primary {
    background-color: var(--color-ivory);
    color: var(--color-navy-deep);
  }

  @media (min-width: 720px) {
    .consent-banner {
      bottom: 16px;
      padding: 12px 12px 12px 24px;
      border-radius: var(--radius-pill);
    }
    .consent-banner__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--spacing-s5);
    }
    .consent-banner__actions {
      flex: none;
    }
  }
</style>

<script>
  const KEY = 'hv-consent';
  const banner = document.querySelector<HTMLElement>('[data-consent]');

  /**
   * Carrega Google Ads, GA4, Clarity e Meta Pixel. Só corre depois de
   * "Aceitar" — antes disso não sai nenhum pedido para terceiros.
   */
  const loadAnalytics = () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const w = window as any;
    if (w.__hvAnalyticsLoaded) return;
    w.__hvAnalyticsLoaded = true;

    const meta = (name: string) =>
      document.querySelector(`meta[name="hv:${name}"]`)?.getAttribute('content') || '';
    const clarity = meta('clarity');
    const pixel = meta('pixel');

    // A etiqueta Google já carrega no <head> com tudo negado (Consent Mode
    // v2 avançado) e a escolha guardada já foi reaplicada lá. Aqui só falta
    // o sinal de "aceite" quando ele acontece nesta visita.
    if (typeof w.gtag === 'function') {
      // ad_personalization fica negado: sem remarketing numa página de saúde.
      w.gtag('consent', 'update', {
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'denied',
        analytics_storage: 'granted',
      });
    }

    if (clarity && !w.clarity) {
      w.clarity = function clarityQueue() {
        // eslint-disable-next-line prefer-rest-params
        (w.clarity.q = w.clarity.q || []).push(arguments);
      };
      const s = document.createElement('script');
      s.async = true;
      s.src = `https://www.clarity.ms/tag/${clarity}`;
      document.head.appendChild(s);
      w.clarity('consent');
    }

    window.dispatchEvent(new CustomEvent('hv:analytics-ready'));

    if (pixel) {
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://connect.facebook.net/en_US/fbevents.js';
      s.onload = () => {
        // @ts-expect-error — fbq é injetado pelo script da Meta.
        window.fbq?.('init', pixel);
        // @ts-expect-error — idem.
        window.fbq?.('track', 'PageView');
      };
      document.head.appendChild(s);
    }
  };

  if (banner) {
    const stored = localStorage.getItem(KEY);

    if (stored === 'aceite') {
      loadAnalytics();
    } else if (stored !== 'recusado') {
      banner.hidden = false;
    }

    const close = (choice: 'aceite' | 'recusado') => {
      try {
        localStorage.setItem(KEY, choice);
      } catch {
        // Armazenamento bloqueado: a escolha vale só para esta visita.
      }
      banner.hidden = true;
      if (choice === 'recusado') {
        // Quem volta atrás numa escolha anterior: retira já o consentimento.
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (window as any).gtag?.('consent', 'update', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
        });
      }
      if (choice === 'aceite') {
        loadAnalytics();
        window.dispatchEvent(new CustomEvent('hv:consent-accepted'));
      }
    };

    banner
      .querySelector('[data-consent-accept]')
      ?.addEventListener('click', () => close('aceite'));
    banner
      .querySelector('[data-consent-reject]')
      ?.addEventListener('click', () => close('recusado'));
  }

  // Link "Definições de cookies" no rodapé reabre a escolha.
  document.querySelector('[data-open-consent]')?.addEventListener('click', () => {
    localStorage.removeItem(KEY);
    if (banner) {
      banner.hidden = false;
      banner.querySelector<HTMLButtonElement>('[data-consent-accept]')?.focus();
    }
  });
</script>
