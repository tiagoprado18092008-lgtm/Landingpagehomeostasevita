---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import Icon from './Icon.astro';
import alphascale from '../assets/brand/alphascale.png';
import livroReclamacoes from '../assets/brand/livro-reclamacoes.jpg';
import LangSwitch from './LangSwitch.astro';
import { localeFromPath, localizePath, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

/**
 * O chão da página, no registo da referência que a cliente escolheu: o nome
 * do espaço em serifa grande a abrir, uma etiqueta "CONTACTO" por baixo, e
 * só depois — muito mais abaixo na hierarquia — colunas de texto miúdo com
 * os dados, os links legais e as licenças.
 *
 * Toda a informação vive numa só laje de navy. Nada de caixas, nada de
 * cartões: a hierarquia faz-se pelo tamanho do tipo e pelo espaço em volta,
 * que é o que dá ao rodapé o ar sereno da referência.
 */
const year = new Date().getFullYear();

/** Portal do Estado. O selo é obrigatório e tem de abrir para aqui. */
const LIVRO_RECLAMACOES = 'https://www.livroreclamacoes.pt/inicio';

const links = [
  { href: '#marcacao', label: t('footer.linkContact') },
  {
    href: localizePath('/politica-de-privacidade', locale),
    label: t('footer.linkPrivacy'),
  },
  { href: localizePath('/politica-de-cookies', locale), label: t('footer.linkCookies') },
];

const redes = [
  { href: site.social.instagram, icon: 'instagram', label: 'Instagram' },
  { href: site.social.facebook, icon: 'facebook', label: 'Facebook' },
] as const;
---

<footer class="footer">
  <div class="footer__laje">
    <span class="footer__brilho" aria-hidden="true"></span>

    <div class="container footer__inner">
      <!-- O nome, em serifa, a abrir ------------------------------------ -->
      <h2 class="footer__nome">
        <a href="#topo" aria-label={`${site.name} — ${t('footer.backToTop')}`}>
          {t('footer.name')}
        </a>
      </h2>

      <p class="footer__eyebrow">{t('footer.contact')}</p>

      <!-- As colunas de detalhe ----------------------------------------- -->
      <div class="footer__grelha">
        <div class="footer__dados">
          <p>
            <strong>{t('footer.address')}</strong>
            {site.address.street}, {site.address.postalCode}&nbsp;{site.address.locality},
            {' '}{t('footer.country')}
          </p>
          <p>
            <strong>{t('footer.phone')}</strong>
            <a href={`tel:${site.phone.tel}`}>{site.phone.display}</a>
          </p>
          <p>
            <strong>{t('footer.email')}</strong>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          <p>
            <strong>{t('footer.bookings')}</strong><br />
            {t('footer.bookingsValue')}
          </p>
        </div>

        <nav class="footer__links" aria-label={t('footer.legalNav')}>
          <ul>
            {
              links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))
            }
            <li>
              <button type="button" class="footer__consent-btn" data-open-consent>
                {t('footer.cookieSettings')}
              </button>
            </li>
          </ul>
        </nav>

        <div class="footer__licencas">
          <p class="footer__licencas-titulo">{t('footer.licences')}</p>
          <p>{t('footer.licenceAcss')} {site.credentials.acss}</p>
          <p class="footer__aviso">{t('common.complementaryNotice')}</p>
        </div>

        <div class="footer__canto">
          <ul class="footer__redes" aria-label={t('footer.social')}>
            {
              redes.map((r) => (
                <li>
                  <a
                    href={r.href}
                    class="footer__rede"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${r.label} ${t('footer.socialOf')}`}
                  >
                    <Icon name={r.icon} size={19} />
                  </a>
                </li>
              ))
            }
          </ul>

          <a
            href={LIVRO_RECLAMACOES}
            class="footer__livro"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('footer.complaints')}
          >
            <Image
              src={livroReclamacoes}
              alt={t('footer.complaintsAlt')}
              width={120}
              loading="lazy"
              class="footer__livro-img"
            />
          </a>
        </div>
      </div>

      <!-- O plinto ------------------------------------------------------ -->
      <div class="footer__base">
        <p class="footer__copy">© {year} {site.legalName}</p>
        <LangSwitch class="footer__lang" />
        <p class="footer__copy">
          <span>{t('footer.builtBy')}</span>
          <a
            href="https://www.alphascaleai.com/"
            class="footer__by"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('footer.builtByAria')}
          >
            <Image
              src={alphascale}
              alt=""
              width={96}
              loading="lazy"
              class="footer__by-logo"
            />
            <span class="footer__by-nome">AlphaScale AI</span>
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-navy-deep);
  }

  .footer__laje {
    --footer-hairline: color-mix(in srgb, var(--color-ivory) 14%, transparent);
    --footer-muted: color-mix(in srgb, var(--color-ivory) 72%, transparent);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--color-navy-deep);
    color: var(--color-ivory);
  }

  .footer__brilho {
    position: absolute;
    z-index: -1;
    top: -44%;
    right: -12%;
    width: min(880px, 76%);
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-teal) 40%, transparent) 0%,
      transparent 62%
    );
    pointer-events: none;
  }

  .footer__inner {
    padding-top: clamp(2.25rem, 4vw, 3.5rem);
  }

  /* ------------------------------------------------------ O nome ------ */
  /* A peça grande da referência. Serifa, peso normal, quebra livre — o nome
     ocupa duas linhas em ecrãs largos e é isso que lhe dá a presença. */
  .footer__nome {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-wordmark);
    font-size: clamp(2.25rem, 6vw, 4.25rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.005em;
    color: var(--color-ivory);
  }

  .footer__nome a {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .footer__nome a:hover,
  .footer__nome a:focus-visible {
    color: var(--color-teal-soft);
  }

  /* A etiqueta, também em serifa e em maiúsculas largas: é o eco pequeno do
     nome, não um título de coluna. */
  .footer__eyebrow {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    font-family: var(--font-wordmark);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ivory);
  }

  /* ---------------------------------------------------- As colunas ---- */
  /* O vão grande entre a etiqueta e a grelha é deliberado: é o que separa o
     registo de marca do registo de informação. */
  .footer__grelha {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--footer-muted);
  }

  .footer__dados p {
    margin: 0 0 var(--spacing-s4);
  }

  .footer__dados p:last-child {
    margin-bottom: 0;
  }

  /* As etiquetas em bold e claro; o valor em tom apagado. Assim lê-se a
     coluna toda de relance sem precisar de títulos por cima. */
  .footer__dados strong {
    font-weight: 700;
    color: var(--color-ivory);
  }

  .footer__dados a {
    color: var(--footer-muted);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-teal-soft) 55%, transparent);
    text-underline-offset: 3px;
    transition: color var(--dur) var(--ease);
  }

  .footer__dados a:hover,
  .footer__dados a:focus-visible {
    color: var(--color-ivory);
    text-decoration-color: var(--color-teal-soft);
  }

  .footer__links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    align-items: flex-start;
  }

  .footer__links a,
  .footer__consent-btn {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ivory);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-teal-soft) 60%, transparent);
    text-underline-offset: 4px;
    transition: color var(--dur) var(--ease);
  }

  .footer__links a:hover,
  .footer__links a:focus-visible,
  .footer__consent-btn:hover,
  .footer__consent-btn:focus-visible {
    color: var(--color-teal-soft);
    text-decoration-color: var(--color-teal-soft);
  }

  .footer__consent-btn {
    padding: 0;
    background: none;
    border: 0;
    font-family: inherit;
    cursor: pointer;
  }

  /* O selo oficial não se recolore — é uma marca do Estado. Fica sobre uma
     placa clara para não flutuar sozinho no navy, e acende ao passar. */
  .footer__canto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-s4);
  }

  .footer__livro {
    display: inline-block;
    padding: 5px;
    border-radius: 6px;
    background-color: var(--color-ivory);
    line-height: 0;
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .footer__livro-img {
    display: block;
    width: clamp(104px, 10vw, 124px);
    height: auto;
  }

  .footer__livro:hover,
  .footer__livro:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--color-teal-soft) 32%, transparent);
  }

  .footer__licencas p {
    margin: 0 0 var(--spacing-s2);
  }

  .footer__licencas-titulo {
    font-weight: 700;
    color: var(--color-ivory);
  }

  .footer__aviso {
    margin-top: var(--spacing-s4);
    max-width: 46ch;
    font-size: 0.875rem;
    line-height: 1.6;
    font-style: italic;
    color: color-mix(in srgb, var(--color-ivory) 75%, transparent);
  }

  /* Os ícones sozinhos, em quadrado de contorno fino, como na referência. */
  .footer__redes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--spacing-s3);
    align-items: flex-start;
  }

  .footer__rede {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid color-mix(in srgb, var(--color-teal-soft) 45%, transparent);
    border-radius: 8px;
    color: var(--color-ivory);
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .footer__rede:hover,
  .footer__rede:focus-visible {
    background-color: var(--color-teal-soft);
    border-color: var(--color-teal-soft);
    color: var(--color-navy-deep);
  }

  /* ------------------------------------------------------ O plinto ---- */
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-s3) var(--spacing-s5);
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding-top: clamp(1rem, 2vw, 1.375rem);
    border-top: 1px solid var(--footer-hairline);
    /* O botão do WhatsApp é fixo ao canto inferior direito: o plinto reserva
       a altura dele (52px) mais o afastamento que ele usa, e acaba sempre
       acima. Manter em sincronia com o `.chat` do ChatWidget. */
    padding-bottom: max(clamp(1.5rem, 2.5vw, 2rem), calc(clamp(16px, 3vw, 28px) + 60px));
  }

  .footer__copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 6px;
    margin: 0;
    min-width: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--footer-muted);
  }

  .footer__copy a {
    color: var(--color-ivory);
    text-decoration: none;
  }

  /* A assinatura de quem fez o site. O emblema da AlphaScale entra em repouso
     sem halo nenhum — é um crédito, não uma segunda marca — e só ao passar o
     cursor acende no ciano da casa. Os dois drop-shadow existem já no estado
     parado (a raio zero e transparentes) porque um filtro só interpola entre
     listas com o mesmo número de funções. */
  .footer__by {
    --as-ciano: 41 194 242;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    vertical-align: middle;
  }

  .footer__by-logo {
    display: block;
    height: 28px;
    width: auto;
    filter: brightness(1) drop-shadow(0 0 0 rgb(var(--as-ciano) / 0))
      drop-shadow(0 0 0 rgb(var(--as-ciano) / 0));
    transition:
      transform var(--dur) var(--ease),
      filter var(--dur) var(--ease);
  }

  .footer__by-nome {
    text-underline-offset: 3px;
    transition: color var(--dur) var(--ease);
  }

  .footer__by:hover,
  .footer__by:focus-visible {
    text-decoration: none;
  }

  .footer__by:hover .footer__by-logo,
  .footer__by:focus-visible .footer__by-logo {
    transform: scale(1.18);
    filter: brightness(1.12) drop-shadow(0 0 8px rgb(var(--as-ciano) / 0.8))
      drop-shadow(0 0 18px rgb(var(--as-ciano) / 0.4));
  }

  .footer__by:hover .footer__by-nome,
  .footer__by:focus-visible .footer__by-nome {
    color: rgb(var(--as-ciano));
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__by:hover .footer__by-logo,
    .footer__by:focus-visible .footer__by-logo,
    .footer__livro:hover,
    .footer__livro:focus-visible {
      transform: none;
    }
  }

  /* ---------------------------------------------------- Adaptação ----- */
  @media (min-width: 640px) {
    .footer__grelha {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Quatro colunas: dados largos, links, licenças, e as redes encostadas à
     direita — a mesma repartição da referência. */
  @media (min-width: 1000px) {
    .footer__grelha {
      /* As três colunas de texto encostam-se à esquerda com um vão curto
         entre si; o resto do vão vai todo para o canto, onde ficam as redes
         e o selo. */
      grid-template-columns: minmax(0, 22rem) minmax(0, 15rem) minmax(0, 18rem) 1fr;
      column-gap: clamp(2rem, 3vw, 3rem);
    }

    .footer__canto {
      align-items: flex-end;
      text-align: right;
    }

    .footer__redes {
      justify-content: flex-end;
    }
  }
</style>
