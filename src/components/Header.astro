---
import { site } from '../config/site';
import Emblem from './Emblem.astro';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { localeFromPath, localizePath, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';

interface Props {
  /**
   * Mantido por compatibilidade com as páginas legais. O header deixou de
   * ficar transparente por cima do hero: é sempre sólido.
   */
  sobreFoto?: boolean;
}

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

/*
 * O logo tem de voltar à página inicial a partir de qualquer sítio —
 * incluindo as páginas legais, que não têm a secção #topo. Só na própria
 * home é que faz sentido usar a âncora (scroll suave, sem recarregar).
 */
const home = localizePath('/', locale);
const norm = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
const estaNaHome = norm(Astro.url.pathname) === norm(home);
const brandHref = estaNaHome ? '#topo' : home;

/* As secções (#servicos, #marcacao, ...) só existem na home — nas páginas
   legais o link tem de levar lá primeiro e só depois saltar para a âncora. */
const secaoHref = (id: string) => (estaNaHome ? `#${id}` : `${home}#${id}`);

/** Navegação principal — pela ordem da página. */
const nav = [
  { id: 'servicos', label: t('nav.treatments') },
  { id: 'terapeuta', label: t('nav.therapist') },
  { id: 'percurso', label: t('nav.firstVisit') },
  { id: 'espaco', label: t('lp.nav.space') },
  { id: 'faq', label: t('nav.questions') },
];
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a href={brandHref} class="brand" aria-label={`${site.name} — ${t('common.homeAria')}`}>
      <Emblem size={44} loading="eager" class="brand__mark" />
      <span class="brand__name wordmark">Homeostase Vita</span>
    </a>

    <nav class="nav" aria-label={t('nav.main')}>
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li>
              <a href={secaoHref(item.id)} class="nav__link" data-nav-link={item.id}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <LangSwitch compacto />
      <a href={`tel:${site.phone.tel}`} class="header-tel" aria-label={`${t('common.call')} ${site.phone.display}`}>
        <Icon name="phone" size={18} />
        <span class="header-tel__numero">{site.phone.display}</span>
      </a>
      <a href={secaoHref('marcacao')} class="btn btn-primary header-cta">{t('common.book')}</a>
      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="menu-mobile"
        data-label-open={t('nav.openMenu')}
        data-label-close={t('nav.closeMenu')}
      >
        <Icon name="menu" class="menu-toggle__open" />
        <Icon name="close" class="menu-toggle__close" />
        <span class="sr-only">{t('nav.openMenu')}</span>
      </button>
    </div>
  </div>
</header>

<!-- Menu mobile em ecrã inteiro -->
<div class="menu-panel" id="menu-mobile" data-menu-panel hidden>
  <nav aria-label={t('nav.small')}>
    <ul class="menu-panel__list">
      {
        nav.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={secaoHref(item.id)} class="menu-panel__link" data-menu-close>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="menu-panel__actions">
    <a href={secaoHref('marcacao')} class="btn btn-primary btn-full" data-menu-close>{t('common.book')}</a>
    <a href={`tel:${site.phone.tel}`} class="btn btn-secondary btn-full">
      <Icon name="phone" size={18} />
      {t('common.call')} {site.phone.display}
    </a>
    <a href={site.phone.whatsapp} class="btn btn-whatsapp btn-full" rel="noopener">
      <Icon name="whatsapp" size={18} />
      WhatsApp
    </a>
  </div>
  <LangSwitch class="menu-panel__lang" />

  <p class="menu-panel__meta">
    {site.address.street}<br />
    {site.address.postalCode}&nbsp;{site.address.locality}
  </p>
</div>

<style>
  /* Barra lisa, sempre sólida: a marca, cinco links, o telefone e a
     marcação. Num anúncio a pessoa decide nos primeiros segundos — o
     telefone e o botão não podem depender de rolar a página. */
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 90;
    background-color: var(--color-paper);
    transition: background-color var(--dur) var(--ease);
  }

  /* Ao rolar, um degrau de tom separa a barra do que passa por baixo. */
  .site-header[data-rolou='true'] {
    background-color: var(--color-step);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-s4);
    min-height: var(--header-h);
    width: 100%;
    /* Mais larga do que a página: marca, cinco links, idioma, telefone e
       botão só cabem numa linha com esta folga. */
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--spacing-s3);
    flex: none;
    min-width: 0;
    min-height: 44px;
    text-decoration: none;
  }

  .brand__name {
    font-size: 1.25rem;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .brand :global(.brand__mark) {
      width: 36px;
      height: auto;
    }
    .brand__name {
      font-size: 0.9375rem;
      letter-spacing: 0.1em;
    }
  }

  .nav {
    display: none;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--spacing-s5), 2.2vw, var(--spacing-s6));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    display: block;
    white-space: nowrap;
    padding: var(--spacing-s2) 0;
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--color-navy-ink);
    text-decoration: none;
    text-underline-offset: 0.4em;
    text-decoration-thickness: 2px;
    transition: color var(--dur) var(--ease);
  }

  .nav__link:hover,
  .nav__link:focus-visible,
  .nav__link[aria-current='true'] {
    color: var(--color-navy);
    text-decoration-line: underline;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-s2);
    flex: none;
  }

  /* Telefone: só o ícone, num disco, no telemóvel; o número por extenso a
     partir do tablet. É o contacto que mais converte numa clínica local. */
  .header-tel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-s2);
    min-width: 48px;
    height: 48px;
    padding-inline: var(--spacing-s3);
    border-radius: var(--radius-pill);
    background-color: var(--color-step-2);
    color: var(--color-navy-deep);
    font-size: var(--t-small);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dur) var(--ease),
      scale var(--dur-fast) var(--ease);
  }
  .header-tel:hover {
    background-color: color-mix(in srgb, var(--color-navy) 17%, var(--color-paper));
  }
  .header-tel:active {
    scale: 0.95;
  }
  .header-tel__numero {
    display: none;
  }

  .header-cta {
    display: none;
    min-height: 48px;
    font-size: var(--t-small);
    padding-inline: var(--spacing-s5);
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: var(--radius-pill);
    color: var(--color-navy);
    cursor: pointer;
    transition: background-color var(--dur) var(--ease);
  }
  .menu-toggle:hover {
    background-color: var(--color-step);
  }

  .menu-toggle :global(svg) {
    width: 24px;
    height: 24px;
  }

  .menu-toggle :global(.menu-toggle__close) {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] :global(.menu-toggle__open) {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] :global(.menu-toggle__close) {
    display: block;
  }

  /* Até ao desktop o idioma vive no painel: o espaço da barra é do telefone. */
  @media (max-width: 1279px) {
    .header-actions :global(.lang) {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .header-cta {
      display: inline-flex;
    }
    .header-tel__numero {
      display: inline;
    }
    .header-tel {
      padding-inline: var(--spacing-s4);
      background-color: transparent;
    }
    .header-tel:hover {
      background-color: var(--color-step);
    }
  }

  @media (min-width: 1280px) {
    .nav {
      display: block;
    }
    .menu-toggle {
      display: none;
    }
  }

  /* --- Painel mobile --- */
  .menu-panel {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s6);
    padding: calc(var(--header-h) + var(--spacing-s4)) var(--gutter) var(--spacing-s7);
    background-color: var(--color-paper);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu-panel[hidden] {
    display: none;
  }

  .menu-panel__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s1);
  }

  .menu-panel__link {
    display: block;
    padding: var(--spacing-s2) 0;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 8vw, 2.5rem);
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-navy-deep);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .menu-panel__link:hover,
  .menu-panel__link:focus-visible {
    color: var(--color-teal-deep);
  }

  .menu-panel:not([hidden]) .menu-panel__list li {
    animation: menu-entrar 500ms var(--ease) both;
    animation-delay: calc(var(--i, 0) * 45ms + 60ms);
  }

  .menu-panel:not([hidden]) .menu-panel__actions {
    animation: menu-entrar 500ms var(--ease) 300ms both;
  }

  @keyframes menu-entrar {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-panel:not([hidden]) .menu-panel__list li,
    .menu-panel:not([hidden]) .menu-panel__actions {
      animation: none;
    }
  }

  .menu-panel__actions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s3);
  }

  .menu-panel__lang {
    align-self: start;
  }

  .menu-panel__meta {
    margin-top: auto;
    font-size: var(--t-small);
    color: var(--color-navy-ink);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');

  // Degrau de tom depois de rolar. Um sentinela evita ouvir o scroll.
  if (header && 'IntersectionObserver' in window) {
    const sentinela = document.createElement('div');
    sentinela.setAttribute('aria-hidden', 'true');
    sentinela.style.cssText =
      'position:absolute;top:0;left:0;width:1px;height:24px;pointer-events:none;';
    document.body.prepend(sentinela);
    new IntersectionObserver(([e]) => {
      header.dataset.rolou = String(!e.isIntersecting);
    }).observe(sentinela);
  }

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  // Menu mobile.
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
      // Os rótulos vêm do HTML (traduzidos no servidor), não de literais aqui.
      const rotulo = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
      if (rotulo) toggle.querySelector('.sr-only')!.textContent = rotulo;
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.querySelectorAll('[data-menu-close]').forEach((el) =>
      el.addEventListener('click', () => setOpen(false)),
    );

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Voltar ao layout desktop fecha o painel.
    window.matchMedia('(min-width: 1280px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // Scroll-spy: sublinha a secção ativa.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const watched = links
    .map((link) => ({ link, el: document.getElementById(link.dataset.navLink!) }))
    .filter((x): x is { link: HTMLAnchorElement; el: HTMLElement } => Boolean(x.el));

  if (watched.length && 'IntersectionObserver' in window) {
    const visible = new Set<HTMLElement>();
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const target = entry.target as HTMLElement;
          if (entry.isIntersecting) visible.add(target);
          else visible.delete(target);
        }
        for (const { link, el } of watched) {
          if (visible.has(el)) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    watched.forEach((w) => spy.observe(w.el));
  }
</script>
