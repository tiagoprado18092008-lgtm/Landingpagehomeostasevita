---
import { localeFromPath, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { getFaq } from '../i18n/content';

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

/**
 * Acordeão nativo (details/summary com `name` partilhado: abre um de cada
 * vez, sem JS). As perguntas que travam a marcação vêm primeiro — dói,
 * quantas sessões, como é a consulta — e só depois as de enquadramento.
 * A ordem é por índice do JSON, para servir as duas línguas.
 */
const ORDEM = [3, 4, 2, 1, 0, 5];
const todas = getFaq(locale);
const faq = ORDEM.map((i) => todas[i]).filter(Boolean);

/* As respostas ainda por confirmar não entram nos dados estruturados: não se
   publica um placeholder como se fosse conteúdo. */
const answered = faq.filter((item) => !item.a.join(' ').includes('⟨TODO'));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: answered.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a.join(' ') },
  })),
};
---

<section class="section faq" id="faq" aria-labelledby="faq-titulo">
  <div class="container faq__grelha">
    <h2 class="faq__titulo reveal" id="faq-titulo">{t('lp.faq.title')}</h2>

    <div class="faq__lista" data-stagger="50">
      {
        faq.map((item) => (
          <details class="faq__item reveal" name="faq">
            <summary class="faq__pergunta">
              <span>{item.q}</span>
              <span class="faq__mais" aria-hidden="true" />
            </summary>
            <div class="faq__resposta">
              {item.a.map((paragrafo) => (
                <p>{paragrafo}</p>
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>

  {
    answered.length > 0 && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    )
  }
</section>

<style>
  .faq {
    background-color: var(--color-paper);
  }

  .faq__grelha {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .faq__titulo {
    font-size: var(--t-h2);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-navy-deep);
  }

  .faq__lista {
    display: grid;
    gap: 8px;
  }

  .faq__item {
    background-color: var(--color-step);
    transition: background-color var(--dur) var(--ease);
  }
  .faq__item:hover {
    background-color: var(--color-step-2);
  }
  .faq__item[open] {
    background-color: var(--color-navy-deep);
    color: var(--color-ivory);
  }

  .faq__pergunta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-s4);
    min-height: 72px;
    padding: var(--spacing-s4) var(--spacing-s5);
    cursor: pointer;
    list-style: none;
    font-size: var(--t-body);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-navy-deep);
  }
  .faq__item[open] .faq__pergunta {
    color: var(--color-ivory);
  }

  .faq__pergunta::-webkit-details-marker {
    display: none;
  }

  /* O "+" desenhado com duas barras de 3px; a vertical deita-se ao abrir. */
  .faq__mais {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }
  .faq__mais::before,
  .faq__mais::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 3px;
    border-radius: 2px;
    background-color: currentColor;
    translate: -50% -50%;
    transition: rotate var(--dur) var(--ease);
  }
  .faq__mais::after {
    rotate: 90deg;
  }
  .faq__item[open] .faq__mais::after {
    rotate: 0deg;
  }

  .faq__resposta {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s3);
    max-width: 58ch;
    padding: 0 var(--spacing-s5) var(--spacing-s5);
    font-size: var(--t-body);
    line-height: 1.6;
  }

  @supports (interpolate-size: allow-keywords) {
    .faq__item::details-content {
      block-size: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        block-size var(--dur) var(--ease),
        content-visibility var(--dur) var(--ease) allow-discrete,
        opacity var(--dur) var(--ease);
    }
    .faq__item[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }

  @media (min-width: 900px) {
    .faq__grelha {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: clamp(2rem, 5vw, 5rem);
    }
    .faq__titulo {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>
