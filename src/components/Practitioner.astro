---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import teresa from '../assets/img/teresa.jpg';
import { localeFromPath, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

/**
 * Quem vai tratar de mim, e se tem habilitação para isso. Vem logo a seguir
 * aos tratamentos, porque é a segunda dúvida de quem pondera marcar: a
 * pessoa, a formação e as duas cédulas da ACSS, ditas com todas as letras.
 *
 * Painel navy recolhido das margens; o retrato vai num círculo — a forma da
 * página — que a base do painel corta.
 */
const cedulas = [
  { area: t('spec.tcm'), numero: site.credentials.acss },
  { area: t('spec.phyto'), numero: site.credentials.acssFito },
];
---

<section class="terapeuta" id="terapeuta" aria-labelledby="terapeuta-titulo">
  <div class="terapeuta__painel">
    <div class="terapeuta__esquerda">
      <h2 class="terapeuta__titulo reveal" id="terapeuta-titulo">{t('lp.p.title')}</h2>
      <div class="terapeuta__retrato reveal">
        <Image
          src={teresa}
          alt={t('practitioner.photoAlt')}
          widths={[480, 720, 1000]}
          sizes="(min-width: 900px) 30vw, 100vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="terapeuta__direita" data-stagger="80">
      <div class="terapeuta__bloco reveal">
        <h3 class="terapeuta__sub">{t('lp.p.trainTitle')}</h3>
        <p>{t('practitioner.bio1')}</p>
        <p set:html={t('practitioner.bio3')} />
      </div>

      <div class="terapeuta__bloco reveal">
        <h3 class="terapeuta__sub">{t('lp.p.practiceTitle')}</h3>
        <p>{t('practitioner.bio2')}</p>
      </div>

      <div class="terapeuta__bloco reveal">
        <h3 class="terapeuta__sub">{t('lp.p.credTitle')}</h3>
        <ul class="terapeuta__cedulas" role="list">
          {
            cedulas.map((c) => (
              <li>
                <span class="terapeuta__ponto" aria-hidden="true" />
                <span>
                  {c.area} — <strong>n.º {c.numero}</strong>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <a href="#marcacao" class="btn terapeuta__btn reveal">{t('lp.p.book')}</a>
    </div>
  </div>
</section>

<style>
  .terapeuta {
    padding: clamp(10px, 1.4vw, 20px);
    background-color: var(--color-paper);
  }

  .terapeuta__painel {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    overflow: hidden;
    padding: clamp(2.5rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 3.5rem) 0;
    background-color: var(--color-navy-deep);
    color: var(--color-ivory);
  }

  .terapeuta__titulo {
    max-width: 16ch;
    font-size: var(--t-h2);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }

  .terapeuta__direita {
    display: grid;
    gap: clamp(2rem, 4vw, 2.75rem);
    align-content: start;
  }

  .terapeuta__sub {
    font-family: var(--font-sans);
    font-size: var(--t-lead);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-ivory);
  }

  .terapeuta__bloco {
    display: grid;
    gap: var(--spacing-s3);
    max-width: 52ch;
    font-size: var(--t-body);
    line-height: 1.6;
  }

  .terapeuta__bloco :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .terapeuta__bloco :global(strong) {
    font-weight: 600;
  }

  .terapeuta__cedulas {
    display: grid;
    gap: var(--spacing-s3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .terapeuta__cedulas li {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-s3);
  }
  .terapeuta__ponto {
    flex: none;
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    background-color: var(--color-green);
  }

  .terapeuta__btn {
    justify-self: start;
    background-color: var(--color-ivory);
    color: var(--color-navy-deep);
  }
  .terapeuta__btn:hover {
    background-color: #fff;
  }

  /* O retrato inteiro, na proporção do original (2:3): a pessoa vê-se da
     cabeça à cintura, sem máscara a cortar-lhe os ombros. */
  .terapeuta__retrato {
    width: min(100%, 26rem);
    aspect-ratio: 2 / 3;
    margin-top: clamp(1rem, 3vw, 2rem);
    overflow: hidden;
    border-radius: var(--radius-foto);
    background-color: #dfe3e8;
  }
  .terapeuta__retrato :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* No telemóvel o retrato fecha o painel, depois do texto. */
  @media (max-width: 899px) {
    .terapeuta__painel {
      display: flex;
      flex-direction: column;
    }
    .terapeuta__esquerda {
      display: contents;
    }
    .terapeuta__retrato {
      order: 3;
      margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    }
    .terapeuta__direita {
      order: 2;
    }
  }

  @media (min-width: 900px) {
    .terapeuta__painel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 5rem);
      padding: clamp(3rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 5rem) 0;
    }
    .terapeuta__esquerda {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .terapeuta__retrato {
      width: min(30vw, 26rem);
      margin: clamp(2rem, 4vw, 3rem) 0 clamp(3rem, 5vw, 4rem);
    }
    .terapeuta__direita {
      padding-bottom: clamp(3rem, 5vw, 4rem);
    }
  }
</style>
