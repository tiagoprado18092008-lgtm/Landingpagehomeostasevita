---
import { Image } from 'astro:assets';
import avaliacao from '../assets/img/avaliacao.jpg';
import { localeFromPath, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);


/**
 * Como se trata, em prosa — o bloco que fecha a lista de tratamentos.
 *
 * Sem eyebrow e com o título a abrir em grande: o bloco passa a ler-se como a
 * apresentação do método da casa, não como mais uma secção rotulada.
 *
 * Substituiu os seis cartões de princípios: diziam a mesma coisa que a
 * Filosofia diz mais abaixo, seis vezes e em caixas iguais. Aqui a mesma
 * matéria cabe em dois parágrafos e ganha o que faltava: o método concreto.
 *
 * A curva no topo é o que faz o navy dos Tratamentos assentar nesta faixa em
 * vez de bater nela a direito. Sobe da esquerda para a direita e é o único
 * corte desenhado da página: repetido, deixava de se notar.
 *
 * À direita, a avaliação do pulso — a fotografia mostra literalmente o que o
 * texto ao lado descreve. Substituiu a arte de anéis concêntricos que servia
 * de marcador enquanto não havia imagem. Fica no rácio nativo (11:6) para não
 * cortar nenhuma das mãos.
 */
---

<section class="abordagem" aria-labelledby="abordagem-titulo">
  <span class="abordagem__curva" aria-hidden="true">
    <svg viewBox="0 0 1440 140" preserveAspectRatio="none" focusable="false">
      <path d="M0,140 L0,96 C480,96 900,4 1440,4 L1440,140 Z" fill="currentColor" />
    </svg>
  </span>

  <div class="container abordagem__inner">
    <div class="abordagem__texto">
      <h2 class="h2 reveal" id="abordagem-titulo">{t('approach.title')}</h2>

      <p class="abordagem__p reveal" style="--reveal-delay:100ms">{t('approach.p1')}</p>

      <p class="abordagem__p reveal" style="--reveal-delay:160ms">{t('approach.p2')}</p>
    </div>

    <figure class="abordagem__arte reveal reveal--scale" style="--reveal-delay:120ms">
      <Image
        class="arte__foto"
        src={avaliacao}
        alt={t('approach.imgAlt')}
        widths={[440, 700, 1100]}
        sizes="(min-width: 900px) 46vw, 92vw"
        quality={82}
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  /* Faixa fria entre o navy dos Tratamentos e o branco da Filosofia. Continua
     a ser a claridade da casa — o que muda é a tonalidade, não o valor. */
  .abordagem {
    --curva-h: clamp(48px, 7vw, 118px);
    --faixa: color-mix(in srgb, var(--color-mist) 46%, var(--color-paper));
    position: relative;
    background-color: var(--faixa);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  /* Sobe por cima da secção anterior. O 1px de folga evita o fio de fundo
     que aparece a arredondar subpixéis em certos zooms. */
  .abordagem__curva {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(1px - var(--curva-h));
    height: var(--curva-h);
    color: var(--faixa);
    pointer-events: none;
  }

  .abordagem__curva svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .abordagem__inner {
    display: grid;
    gap: clamp(2.25rem, 4vw, 4rem);
    align-items: center;
  }

  /* Título a abrir o bloco, sem rótulo por cima: ganha um ponto de escala
     para sustentar sozinho o topo da coluna. */
  .abordagem__texto .h2 {
    max-width: 14ch;
    font-size: clamp(2rem, 4.4vw, 3.25rem);
  }

  /* Sobre a faixa fria o texto corrido fica a navy-ink, não a cinzento: é
     leitura longa e o contraste do `muted` aqui ficava no limite. */
  .abordagem__p {
    margin-top: var(--spacing-s5);
    max-width: 54ch;
    font-size: var(--text-body);
    line-height: 1.8;
    color: var(--text);
  }

  /* --- A fotografia: a avaliação do pulso --- */
  .abordagem__arte {
    position: relative;
    margin: 0;
    /* Rácio nativo da fotografia (1100×600): sem corte, ficam as duas mãos. */
    aspect-ratio: 11 / 6;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background-color: var(--color-paper);
    box-shadow: var(--shadow-2);
  }

  .abordagem__arte :global(.arte__foto) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (min-width: 900px) {
    .abordagem__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

  }
</style>
