---
import { Image } from 'astro:assets';
import { slugify } from '../config/site';
import { localeFromPath, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { getServices, type Service } from '../i18n/content';

import acupuntura from '../assets/img/acupuntura.jpg';
import auriculoterapia from '../assets/img/auriculoterapia.jpg';
import craniopuntura from '../assets/img/craniopuntura.jpg';

/**
 * Os tratamentos lado a lado, cada um com a sua fotografia grande, em
 * 4:3 e de cantos arredondados, e o texto da clínica por baixo. Antes era
 * um índice com miniaturas e uma moldura que mudava ao passar o rato: as
 * fotografias ficavam pequenas e a moldura deixava um vazio por baixo.
 *
 * O recorte de cada fotografia aponta para o assunto (a orelha está à
 * direita no original da auriculoterapia; as agulhas da craniopuntura, em
 * cima). As técnicas e os textos vêm do JSON validado pela clínica.
 *
 * NOTA: os originais de acupuntura (540px) e auriculoterapia (512px) são
 * pequenos — em ecrã Retina ficam menos nítidos. Trocar por maiores quando
 * houver.
 */
const locale: Locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const tratamentos: Service[] = getServices(locale);

const fotos: Record<string, ImageMetadata> = { acupuntura, auriculoterapia, craniopuntura };
const enquadramento: Record<string, string> = {
  acupuntura: '45% 50%',
  auriculoterapia: '64% 50%',
  craniopuntura: '50% 30%',
};
---

<section class="section trat" id="servicos" aria-labelledby="servicos-titulo">
  <div class="container">
    <div class="trat__cabeca">
      <h2 class="trat__titulo reveal" id="servicos-titulo">{t('lp.t.title')}</h2>
      <p class="trat__lead reveal">{t('services.intro')}</p>
    </div>

    <ul class="trat__lista" role="list" data-stagger="90">
      {
        tratamentos.map((s) => (
          <li class="trat__item reveal" id={`trat-${slugify(s.anchor ?? s.name)}`}>
            {s.image && fotos[s.image] && (
              <div class="trat__foto">
                <Image
                  src={fotos[s.image]}
                  alt={s.alt ?? ''}
                  widths={[400, 640, 900, 1100]}
                  sizes="(min-width: 900px) 30vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  style={`object-position:${enquadramento[s.image] ?? '50% 50%'}`}
                />
              </div>
            )}
            <h3 class="trat__nome">{s.name}</h3>
            <p class="trat__texto">{s.description}</p>
          </li>
        ))
      }
    </ul>

    <div class="trat__fecho reveal">
      <p class="trat__nota">{t('services.note')}</p>
      <a href="#marcacao" class="btn btn-primary">{t('common.book')}</a>
    </div>
  </div>
</section>

<style>
  .trat {
    background-color: var(--color-step);
  }

  .trat__cabeca {
    display: grid;
    gap: var(--spacing-s5);
    align-items: end;
  }

  .trat__titulo {
    font-size: var(--t-h2);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-navy-deep);
  }

  .trat__lead {
    max-width: 50ch;
    font-size: var(--t-body);
    color: var(--color-navy-ink);
  }

  .trat__lista {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3rem) clamp(1.5rem, 2.5vw, 2.5rem);
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .trat__foto {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-foto);
    background-color: var(--color-step-2);
  }
  .trat__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--dur-slow) var(--ease);
  }
  .trat__item:hover .trat__foto :global(img) {
    scale: 1.03;
  }

  .trat__nome {
    margin-top: var(--spacing-s5);
    font-size: clamp(1.75rem, 2.4vw, 2.25rem);
    line-height: 1.1;
    color: var(--color-navy-deep);
  }

  .trat__texto {
    max-width: 46ch;
    margin-top: var(--spacing-s3);
    font-size: var(--t-body);
    color: var(--color-navy-ink);
  }

  .trat__fecho {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-s4) var(--spacing-s6);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .trat__nota {
    max-width: 50ch;
    font-size: var(--t-body);
    color: var(--color-navy-ink);
  }

  @media (min-width: 900px) {
    .trat__cabeca {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(2rem, 5vw, 5rem);
    }
    .trat__lead {
      justify-self: end;
    }
    .trat__lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trat__item:hover .trat__foto :global(img) {
      scale: 1;
    }
  }
</style>
