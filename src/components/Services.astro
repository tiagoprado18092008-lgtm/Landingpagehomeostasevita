---
import { Image } from 'astro:assets';
import { slugify } from '../config/site';
import { localeFromPath, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { getServices, type Service } from '../i18n/content';
import Placeholder from './Placeholder.astro';

import acupuntura from '../assets/img/acupuntura.jpg';
import auriculoterapia from '../assets/img/auriculoterapia.jpg';
import ventosaterapia from '../assets/img/ventosaterapia.webp';
import reflexologia from '../assets/img/reflexologia.jpg';

/**
 * Os tratamentos como índice editorial, e não como grelha de cartões.
 *
 * Quatro cartões lado a lado liam-se como uma tabela de produtos e obrigavam
 * cada fotografia a ser pequena. Aqui a secção divide-se em duas colunas: a
 * fotografia grande à esquerda, fixa enquanto se rola, e à direita a lista
 * dos tratamentos separada por filetes. Passar o rato (ou focar pelo
 * teclado) num item troca a fotografia — uma imagem de cada vez, em tamanho
 * que se vê, em vez de quatro miniaturas ao mesmo tempo.
 *
 * O texto de cada tratamento vive dentro do respectivo item e abre com ele:
 * quem só passa os olhos lê os nomes, quem quer saber mais para o cursor.
 *
 * Sem JS a coluna da imagem mostra a primeira fotografia e a lista continua
 * a ser uma lista legível com todo o texto visível — o CSS trata do estado
 * :hover/:focus-within sem precisar de script para a troca de imagem.
 *
 * Em ecrã estreito não há duas colunas: cada item leva a sua própria
 * fotografia por cima do texto, empilhados.
 */

/*
 * O tipo e o texto dos tratamentos vivem em `src/i18n/content.ts`: o
 * português continua a sair do JSON editável, o inglês da tradução ao lado.
 *
 * TODO(cliente): o segundo parágrafo de cada item (`detail`) foi redigido
 * aqui e está por validar pela terapeuta, nas duas línguas. É deliberadamente
 * descritivo — nenhuma frase diz que a técnica trata ou melhora seja o que
 * for, porque isso é afirmação clínica e só pode sair de quem exerce.
 */
const locale: Locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const tratamentos: Service[] = getServices(locale);

const fotos: Record<string, ImageMetadata> = {
  acupuntura,
  auriculoterapia,
  ventosaterapia,
  reflexologia,
};

/* A fotografia grande ocupa perto de metade da secção em desktop; ao alto
   passa a largura inteira. */
const SIZES = '(min-width: 1000px) 46vw, 100vw';
---

<section
  class="section section-lg surface-white tratamentos"
  id="servicos"
  aria-labelledby="servicos-titulo"
>
  <div class="container tratamentos__container">
    <div class="section-head-editorial">
      <div>
        <p class="eyebrow reveal">{t('services.eyebrow')}</p>
        <h2 class="h2 reveal" id="servicos-titulo">{t('services.title')}</h2>
      </div>
      <p class="lead reveal" style="--reveal-delay:80ms">
        {t('services.intro')}
      </p>
    </div>

    <div class="indice-trat">
      {/* --- Coluna da fotografia ---
          Uma pilha de imagens sobrepostas: todas carregadas, só a activa
          visível. A troca é uma transição de opacidade, não um carregamento,
          por isso não há espera nem salto de layout. */}
      <div class="indice-trat__palco" aria-hidden="true">
        <div class="indice-trat__moldura ratio-retrato">
          {
            tratamentos.map((s, i) => (
              <div class="indice-trat__chapa" data-foto={i}>
                {s.image && fotos[s.image] ? (
                  <Image
                    class="indice-trat__img"
                    src={fotos[s.image]}
                    alt=""
                    widths={[400, 640, 900, 1120]}
                    sizes={SIZES}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Placeholder label={s.photo} ratio="3 / 4" seed={i} />
                )}
              </div>
            ))
          }
        </div>
      </div>

      {/* --- Coluna da lista --- */}
      <ol class="indice-trat__lista lista-filete" data-stagger="90">
        {
          tratamentos.map((s, i) => (
            <li class="reveal" id={`trat-${slugify(s.anchor ?? s.name)}`}>
              <div class="trat" data-item={i} tabindex="0">
                <span class="indice trat__num">{String(i + 1).padStart(2, '0')}</span>

                <div class="trat__corpo">
                  <h3 class="h3 trat__nome">{s.name}</h3>
                  <p class="trat__desc">{s.description}</p>
                  {s.detail && <p class="trat__detalhe">{s.detail}</p>}
                </div>

                {/* Ao alto a fotografia vive dentro do próprio item: a
                    coluna fixa da esquerda não existe nesse tamanho. */}
                <div class="trat__foto-movel ratio-paisagem">
                  {s.image && fotos[s.image] ? (
                    <Image
                      class="indice-trat__img"
                      src={fotos[s.image]}
                      alt={s.alt ?? ''}
                      widths={[400, 640, 900]}
                      sizes="100vw"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <Placeholder label={s.photo} ratio="3 / 2" seed={i} />
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="tratamentos__cta reveal">
      <p class="tratamentos__nota">{t('services.note')}</p>
      <a href="#marcacao" class="btn btn-secondary">{t('common.book')}</a>
    </div>
  </div>
</section>

<style>
  .tratamentos__container {
    max-width: 1340px;
  }

  /* --- A grelha de duas colunas -----------------------------------------
     Ao alto é uma coluna só e a fotografia grande desaparece: cada item
     traz a sua. A partir de 1000px abrem-se as duas colunas e a fotografia
     passa a ser uma só, partilhada. */
  .indice-trat {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .indice-trat__palco {
    display: none;
  }

  @media (min-width: 1000px) {
    .indice-trat {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
    }

    .indice-trat__palco {
      display: block;
      /* Acompanha a leitura da lista em vez de fugir para cima. */
      position: sticky;
      top: calc(var(--header-h) + var(--spacing-s6));
    }

    .trat__foto-movel {
      display: none;
    }
  }

  .indice-trat__moldura {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--color-mist);
  }

  /* Todas empilhadas no mesmo sítio; só a activa tem opacidade. */
  .indice-trat__chapa {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease);
  }

  /* A primeira é a que se vê em repouso — e é também a que fica quando
     nada está em foco. */
  .indice-trat__chapa[data-foto='0'] {
    opacity: 1;
  }

  .indice-trat__moldura :global(.indice-trat__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .indice-trat__moldura :global(.ph) {
    width: 100%;
    height: 100%;
    border-radius: 0;
    box-shadow: none;
  }

  /* --- A lista ---------------------------------------------------------- */
  .indice-trat__lista {
    margin: 0;
    padding: 0;
  }

  /* Herda a estrutura de .item-filete mas com o texto a ocupar a coluna
     do meio e o número à cabeça. */
  .trat {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1rem, 2.4vw, 2rem);
    padding-block: clamp(1.5rem, 2.8vw, 2.25rem);
    cursor: default;
    transition:
      padding-inline var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }

  .trat:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .trat__num {
    padding-top: 0.55em;
  }

  .trat__corpo {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s3);
    min-width: 0;
  }

  .trat__nome {
    color: var(--brand);
    transition: color var(--dur) var(--ease);
  }

  .trat__desc {
    max-width: 52ch;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .trat__detalhe {
    max-width: 52ch;
    font-size: 0.875rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-muted) 82%, transparent);
  }

  /* Fotografia dentro do item — só ao alto. */
  .trat__foto-movel {
    grid-column: 1 / -1;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--color-mist);
  }

  .trat__foto-movel :global(.indice-trat__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .trat__foto-movel :global(.ph) {
    width: 100%;
    height: 100%;
    border-radius: 0;
    box-shadow: none;
  }

  /* --- O estado activo --------------------------------------------------
     Só onde há rato e duas colunas. O item em foco desloca-se para dentro
     e os outros esmorecem; a fotografia correspondente sobe ao cimo da
     pilha. Tudo em CSS: `:has()` deixa o palco reagir ao item da lista sem
     uma linha de JavaScript. */
  @media (hover: hover) and (min-width: 1000px) {
    .indice-trat__lista:hover .trat,
    .indice-trat__lista:focus-within .trat {
      opacity: 0.45;
    }

    .indice-trat__lista .trat:hover,
    .indice-trat__lista .trat:focus-visible {
      opacity: 1;
      padding-inline: var(--spacing-s4) 0;
    }

    .trat:hover .trat__nome,
    .trat:focus-visible .trat__nome {
      color: var(--color-teal-deep);
    }

    /* A chapa activa: quando um item está em foco, a chapa com o mesmo
       índice aparece e a primeira (a de repouso) apaga-se. */
    .indice-trat:has(.trat[data-item='0']:hover) .indice-trat__chapa[data-foto='0'],
    .indice-trat:has(.trat[data-item='0']:focus-visible) .indice-trat__chapa[data-foto='0'],
    .indice-trat:has(.trat[data-item='1']:hover) .indice-trat__chapa[data-foto='1'],
    .indice-trat:has(.trat[data-item='1']:focus-visible) .indice-trat__chapa[data-foto='1'],
    .indice-trat:has(.trat[data-item='2']:hover) .indice-trat__chapa[data-foto='2'],
    .indice-trat:has(.trat[data-item='2']:focus-visible) .indice-trat__chapa[data-foto='2'],
    .indice-trat:has(.trat[data-item='3']:hover) .indice-trat__chapa[data-foto='3'],
    .indice-trat:has(.trat[data-item='3']:focus-visible) .indice-trat__chapa[data-foto='3'] {
      opacity: 1;
    }

    .indice-trat:has(.trat[data-item='1']:hover) .indice-trat__chapa[data-foto='0'],
    .indice-trat:has(.trat[data-item='1']:focus-visible) .indice-trat__chapa[data-foto='0'],
    .indice-trat:has(.trat[data-item='2']:hover) .indice-trat__chapa[data-foto='0'],
    .indice-trat:has(.trat[data-item='2']:focus-visible) .indice-trat__chapa[data-foto='0'],
    .indice-trat:has(.trat[data-item='3']:hover) .indice-trat__chapa[data-foto='0'],
    .indice-trat:has(.trat[data-item='3']:focus-visible) .indice-trat__chapa[data-foto='0'] {
      opacity: 0;
    }
  }

  /* --- Remate ----------------------------------------------------------- */
  .tratamentos__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-s5);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: var(--spacing-s6);
    border-top: 1px solid var(--hairline-cool);
  }

  .tratamentos__nota {
    max-width: 52ch;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .indice-trat__chapa,
    .trat {
      transition: none;
    }
  }
</style>
