---
import { Image } from 'astro:assets';
import { slugify } from '../config/site';
import { localeFromPath, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { getServices, type Service } from '../i18n/content';
import Placeholder from './Placeholder.astro';

import acupuntura from '../assets/img/acupuntura.jpg';
import auriculoterapia from '../assets/img/auriculoterapia.jpg';
import craniopuntura from '../assets/img/craniopuntura.jpg';

/**
 * Os três tratamentos em linha, em cartões navy altos sobre fundo claro.
 * É a única secção com fotografias — quem tem fotografia mostra-a; quem
 * ainda não tem fica com o slot identificado.
 *
 * Cada cartão leva dois parágrafos e não um. A folga entre eles é maior do
 * que a do resto da página de propósito — colunas encostadas liam-se como
 * uma tabela.
 */

/*
 * O tipo e o texto dos tratamentos vivem em `src/i18n/content.ts`: o
 * português continua a sair do JSON editável, o inglês da tradução ao lado.
 *
 * TODO(cliente): o segundo parágrafo de cada cartão (`detail`) foi redigido
 * aqui e está por validar pela terapeuta, nas duas línguas. É deliberadamente
 * descritivo — nenhuma frase diz que a técnica trata ou melhora seja o que
 * for, porque isso é afirmação clínica e só pode sair de quem exerce.
 */
const locale: Locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const tratamentos: Service[] = getServices(locale);

const fotos: Record<string, ImageMetadata> = {
  acupuntura,
  auriculoterapia,
  craniopuntura,
};

// Três em linha no desktop, dois em tablet, um em telemóvel.
const SIZES = '(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw';
---

<section class="section surface-white tratamentos" id="servicos" aria-labelledby="servicos-titulo">
  <div class="container tratamentos__container">
    <div class="tratamentos__head">
      <div>
        <p class="eyebrow reveal">{t('services.eyebrow')}</p>
        <h2 class="h2 reveal" id="servicos-titulo">{t('services.title')}</h2>
      </div>
      <p class="tratamentos__intro reveal" style="--reveal-delay:80ms">
        {t('services.intro')}
      </p>
    </div>

    <ul class="tratamentos__grid" data-stagger="90">
      {
        tratamentos.map((s, i) => (
          <li class="trat reveal" id={`trat-${slugify(s.anchor ?? s.name)}`}>
            <span class="zoom-alvo trat__foto">
              {s.image && fotos[s.image] ? (
                <Image
                  class="trat__img"
                  src={fotos[s.image]}
                  alt={s.alt ?? ''}
                  widths={[400, 640, 900, 1120]}
                  sizes={SIZES}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Placeholder label={s.photo} ratio="1 / 1" seed={i} />
              )}
            </span>
            <div class="trat__corpo">
              <h3 class="h3 trat__nome">{s.name}</h3>
              <p class="trat__desc">{s.description}</p>
              {s.detail && <p class="trat__detalhe">{s.detail}</p>}
            </div>
          </li>
        ))
      }
    </ul>

    <div class="tratamentos__cta reveal">
      <p class="tratamentos__nota">{t('services.note')}</p>
      <a href="#marcacao" class="btn btn-secondary">{t('common.book')}</a>
    </div>
  </div>
</section>

<style>
  /* Com três colunas a medida de linha dentro do container normal já
     respira, mas mantém-se uma folga sobre os 1200 da casa para que os
     cartões não fiquem estreitos em ecrãs largos. */
  .tratamentos__container {
    max-width: 1200px;
  }

  .tratamentos__head {
    display: grid;
    gap: var(--spacing-s5);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .tratamentos__head .eyebrow {
    margin-bottom: var(--spacing-s3);
  }

  .tratamentos__intro {
    max-width: 46ch;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .tratamentos__grid {
    display: grid;
    gap: clamp(1.25rem, 2.2vw, 2rem);
    grid-template-columns: 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Fundo claro, cartões navy: a fotografia é a única coisa colorida em cada
     cartão e o navy por baixo dela põe-na a arder, coisa que o cartão branco
     não fazia. */
  .trat {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--color-navy-deep);
    box-shadow: var(--shadow-1);
    transition:
      translate var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .trat:hover,
  .trat:focus-within {
    translate: 0 -3px;
    box-shadow: var(--shadow-3);
  }

  /* A entrada é um desenrolar, não um fade: a fotografia descobre-se de
     cima para baixo enquanto o cartão sobe. Um gesto diferente do resto da
     página, porque este é o único sítio com imagem.
     O recorte vive na fotografia e nunca no `li`: um `clip-path` no próprio
     elemento observado zera a sua área de intersecção e o observador nunca
     lhe chegava a pôr o `.is-visible` — ficavam invisíveis para sempre. */
  .trat__foto {
    position: relative;
    clip-path: inset(0 0 100% 0);
  }

  .trat.is-visible .trat__foto {
    animation: desenrolar 900ms var(--ease) calc(var(--reveal-delay, 0ms) + 120ms) both;
  }

  @keyframes desenrolar {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .trat__foto::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-navy-deep) 34%, transparent),
      color-mix(in srgb, var(--color-teal-deep) 46%, transparent)
    );
    opacity: 1;
    transition: opacity var(--dur-slow) var(--ease);
  }

  .trat:hover .trat__foto::after,
  .trat:focus-within .trat__foto::after {
    opacity: 0;
  }

  /* O placeholder traz o seu próprio raio; aqui o corte é do cartão. */
  .trat :global(.ph) {
    border-radius: 0;
    box-shadow: none;
  }

  .trat__foto {
    display: block;
  }

  /* Quadrada, e não 4/3: dá mais um terço de altura à fotografia sem a
     esticar mais do que os originais aguentam. Duas destas fotografias têm
     pouco mais de 500 px de largura — num recorte mais alto do que 1:1 a
     zona aproveitada já não chegava para ecrãs retina. */
  .trat :global(.trat__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background-color: var(--color-mist);
  }

  .trat__corpo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-s3);
    padding: clamp(1.25rem, 1.9vw, 1.625rem);
  }

  .trat__nome {
    font-size: clamp(1.1875rem, 1.5vw, 1.375rem);
    color: var(--color-ivory);
  }

  .trat__desc {
    font-size: 1rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-ivory) 90%, transparent);
  }

  /* O segundo parágrafo — o que é e como decorre — recua um tom e fica
     separado por um filete, para se ler como nota e não como continuação. */
  .trat__detalhe {
    margin-top: var(--spacing-s2);
    padding-top: var(--spacing-s4);
    border-top: 1px solid color-mix(in srgb, var(--color-ivory) 16%, transparent);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-ivory) 78%, transparent);
  }

  /* Sem JS — ou com movimento reduzido — a fotografia está simplesmente lá. */
  :global(.no-js) .trat__foto {
    clip-path: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .trat__foto,
    .trat.is-visible .trat__foto {
      clip-path: none;
      animation: none;
    }
  }

  .tratamentos__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-s4);
    margin-top: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  .tratamentos__nota {
    max-width: 44ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  @media (min-width: 640px) {
    .tratamentos__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .tratamentos__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
