---
/**
 * Mandala botânica yin-yang. Elemento recorrente pequeno — nunca esticado,
 * nunca recolorido. A proporção original (1278×1230) é preservada.
 *
 * Serve um único PNG de 520 px com paleta de 64 cores (19,6 KB) em vez de
 * passar pelo `astro:assets`: o desenho é de cor chapada com contornos
 * definidos, e o WebP com perdas custava aqui 74 KB para pior resultado.
 * Um só ficheiro cobre o header (40 px), o rodapé (52 px) e o hero (248 px
 * a 2×), e fica em cache para os três.
 *
 * Se o emblema for exportado para SVG, trocar este <img> pelo vetor.
 */
interface Props {
  size?: number;
  class?: string;
  /** Decorativo por omissão; passar alt quando carrega significado. */
  alt?: string;
  loading?: 'eager' | 'lazy';
}
const { size = 56, class: className, alt = '', loading = 'lazy' } = Astro.props;
const height = Math.round((size * 500) / 520);
---

<img
  src="/emblema.png"
  alt={alt}
  width={size}
  height={height}
  loading={loading}
  decoding="async"
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  class={className}
/>
