---
import benefits from '../content/benefits.json';
import Ambient from './Ambient.astro';
import Icon from './Icon.astro';

/**
 * Quatro cartões brancos, o ícone em baixo. É o gesto mais limpo da página:
 * respiração generosa, cantos macios, nada de molduras pesadas.
 */
---

<section class="section surface-cloud porque tem-ambiente" aria-labelledby="porque-titulo">
  <Ambient variant="duplo" opacity={0.55} />

  <div class="container">
    <div class="section-head">
      <p class="eyebrow reveal">Porquê a Homeostase Vita</p>
      <h2 class="h2 reveal" id="porque-titulo">Uma abordagem centrada na pessoa</h2>
      <p class="lead reveal">
        Seis princípios que orientam a forma como cada acompanhamento é conduzido.
      </p>
    </div>

    <ul class="porque__grid" data-stagger="90">
      {
        benefits.map((b, i) => (
          <li class="porque__card reveal reveal--scale">
            <h3 class="h3 porque__title">{b.title}</h3>
            <p class="porque__text">{b.description}</p>
            <span class={`porque__icon porque__icon--${['navy', 'teal', 'green'][i % 3]}`} aria-hidden="true">
              <Icon name={b.icon} size={30} />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .porque__grid {
    display: grid;
    gap: var(--spacing-s4);
    grid-template-columns: 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .porque__card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s3);
    min-height: 260px;
    padding: clamp(1.5rem, 2.4vw, 2rem);
    border-radius: var(--radius-lg);
    background-color: #fff;
    transition:
      box-shadow var(--dur) var(--ease),
      translate var(--dur) var(--ease);
  }

  .porque__card:hover {
    box-shadow: var(--shadow-2);
    translate: 0 -3px;
  }

  .porque__icon {
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .porque__card:hover .porque__icon {
    background-color: var(--color-navy);
    color: var(--color-teal-soft);
  }

  .porque__title {
    color: var(--color-navy);
    max-width: 18ch;
  }

  .porque__text {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  /* O ícone assenta no fundo do cartão, como no modelo. As três cores
     alternam navy / azul / verde — as cores da marca e do emblema. */
  .porque__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-top: auto;
    border-radius: var(--radius-md);
  }

  .porque__icon--navy {
    background-color: color-mix(in srgb, var(--color-navy) 16%, var(--color-paper));
    color: var(--color-navy);
  }

  .porque__icon--teal {
    background-color: color-mix(in srgb, var(--color-teal) 24%, var(--color-paper));
    color: var(--color-teal-deep);
  }

  .porque__icon--green {
    background-color: color-mix(in srgb, var(--color-green) 24%, var(--color-paper));
    color: var(--color-green-deep);
  }

  @media (min-width: 620px) {
    .porque__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .porque__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
